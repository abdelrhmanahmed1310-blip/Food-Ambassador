enum MembershipStatus {
  ACTIVE
  REMOVED
}

model OrganizationMembership {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt       DateTime?        @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// ───────────────────────────── Access control ─────────────────────────────
// Permission codes are defined in code (src/modules/access/permissions.ts) and
// validated before being stored.

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]
  invitations     Invitation[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permission     String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([organizationId])
  @@map("role_permissions")
}

enum ScopeType {
  ORGANIZATION
  BRANCH
  WAREHOUSE
}

/// A role granted to a member, optionally limited to one branch or warehouse.
/// CHECK constraint (migration): exactly the column matching scope_type is set.
model MembershipRole {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  scopeType      ScopeType @default(ORGANIZATION) @map("scope_type")
  branchId       String?   @map("branch_id") @db.Uuid
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role         Role                   @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch?                @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse?             @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  /// Recreated in SQL as NULLS NOT DISTINCT.
  @@unique([membershipId, roleId, scopeType, branchId, warehouseId], map: "membership_roles_grant_key")
  @@index([organizationId, membershipId])
  @@map("membership_roles")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String
  roleId           String           @map("role_id") @db.Uuid
  scopeType        ScopeType        @default(ORGANIZATION) @map("scope_type")
  branchId         String?          @map("branch_id") @db.Uuid
  warehouseId      String?          @map("warehouse_id") @db.Uuid
  /// SHA-256 of the secret token; the token itself is shown once to the inviter.
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse?   @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("invitations")
}

// ───────────────────────────── Sites ─────────────────────────────

enum BranchType {
  RESTAURANT
  CENTRAL_KITCHEN
  WAREHOUSE_SITE
  OFFICE
  OTHER
}

model Branch {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  /// The legal entity this branch belongs to (F1, ADR-082).
  companyId       String     @map("company_id") @db.Uuid
  brandId         String?    @map("brand_id") @db.Uuid
  code            String
  name            String
  type            BranchType
  timeZone        String?    @map("time_zone")
  addressLine     String?    @map("address_line")
  city            String?
  country         String?    @db.Char(2)
  archivedAt      DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  updatedByUserId String     @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses        Warehouse[]
  membershipRoles   MembershipRole[]
  invitations       Invitation[]
  safetyCheckpoints SafetyCheckpoint[]
  safetyRecords     FoodSafetyRecord[]
  checklistRuns     ChecklistRun[]
  nonConformances   NonConformance[]

  menuItemPrices      MenuItemPrice[]
  menuItemUnavailable MenuItemUnavailable[]

  posRegisters        PosRegister[]
  posFloors           PosFloor[]
  posTables           PosTable[]
  posTabs             PosTab[]
  orderingChannels    OrderingChannel[]
  kitchenStations     KitchenStation[]
  employees           Employee[]
  attendanceTerminals AttendanceTerminal[]
  geofence            BranchGeofence?
  attendancePunches   AttendancePunch[]
  company             Company              @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  brand               Brand?               @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  haccpPlans          HaccpPlan[]
  fsDocuments         FsDocument[]
  audits              Audit[]
  complaints          Complaint[]
  equipment           Equipment[]
  mockRecalls         MockRecall[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("branches")
}

enum WarehouseType {
  MAIN
  KITCHEN_STORE
  BAR
  TRANSIT
  OTHER
}

model Warehouse {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  code            String
  name            String
  type            WarehouseType
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  updatedByUserId String        @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  locations        StorageLocation[]
  membershipRoles  MembershipRole[]
  invitations      Invitation[]
  ledgerEntries    InventoryLedgerEntry[]
  balances         StockBalance[]
  documents        InventoryDocument[]    @relation("DocumentWarehouse")
  inboundDocs      InventoryDocument[]    @relation("DocumentDestination")
  stockCounts      StockCount[]
  valuations       StockValuation[]
  revaluations     StockRevaluation[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  reorderRules     ReorderRule[]
  shipmentsOut     StockShipment[]        @relation("ShipmentFrom")
  shipmentsIn      StockShipment[]        @relation("ShipmentTo")
  landedCosts      LandedCost[]
  landedCostLines  LandedCostLine[]
  requisitions     PurchaseRequisition[]
  recipeSnapshots  RecipeCostSnapshot[]
  recallStock      RecallStock[]
  salesImports     SalesImport[]
  productionOrders ProductionOrder[]
  salesOrders      SalesOrder[]

  posRegisters       PosRegister[]
  posFloors          PosFloor[]
  posTabs            PosTab[]
  rfqs               Rfq[]
  supplierReturns    SupplierReturn[]
  mockRecallCounts   MockRecallCount[]
  receiptInspections ReceiptInspection[]
  putawayRules       PutawayRule[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, branchId])
  @@map("warehouses")
}

enum TemperatureZone {
  AMBIENT
  CHILLED
  FROZEN
}

/// What a storage location is used for (ADR-101).
enum LocationZone {
  RECEIVING
  QUARANTINE
  STORAGE
  PICKING
  DISPATCH
}

model StorageLocation {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  warehouseId     String          @map("warehouse_id") @db.Uuid
  code            String
  name            String
  temperatureZone TemperatureZone @map("temperature_zone")
  zone            LocationZone    @default(STORAGE)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  updatedByUserId String          @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse     Warehouse              @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  ledgerEntries InventoryLedgerEntry[]
  balances      StockBalance[]
  goodsReceipts GoodsReceipt[]
  shipmentLines StockShipmentLine[]
  shipmentsIn   StockShipment[]
  stockCounts   StockCount[]
  countLines    StockCountLine[]
  putawayRules  PutawayRule[]

  @@unique([organizationId, id])
  /// Lets ledger rows prove their location belongs to their warehouse.
  @@unique([organizationId, warehouseId, id])
  @@unique([organizationId, warehouseId, code])
  @@map("storage_locations")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Append-only (UPDATE/DELETE rejected by trigger).
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  changes        Json?
  requestId      String?  @map("request_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

/// Records completed idempotent operations so a repeated submission returns
/// the original result instead of creating a duplicate.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  operation      String
  requestHash    String   @map("request_hash")
  result         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, key])
  @@map("idempotency_keys")
}

// ───────────────────────────── Catalog (Milestone 2) ─────────────────────────────

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

/// System units have organization_id NULL and are visible to every tenant.
model UnitOfMeasure {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  code           String
  nameEn         String        @map("name_en")
  nameAr         String        @map("name_ar")
  dimension      UnitDimension
  /// Size in the dimension base unit (g, ml, each); NULL = packaging unit
  /// that converts only through a product-specific factor.
  factorToBase   Decimal?      @map("factor_to_base") @db.Decimal(30, 12)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization        Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  baseOf              Product[]
  conversions         ProductUomConversion[]
  barcodes            ProductBarcode[]
  ledgerEntries       InventoryLedgerEntry[]
  supplierProducts    SupplierProduct[]
  purchaseOrderLines  PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]
  shipmentLines       StockShipmentLine[]
  requisitionLines    PurchaseRequisitionLine[]
  recipeIngredients   RecipeIngredient[]
  recipeYields        RecipeVersion[]
  invoiceLines        SupplierInvoiceLine[]
  salesOrderLines     SalesOrderLine[]
  productionOrders    ProductionOrder[]
  rfqLines            RfqLine[]
  supplierReturnLines SupplierReturnLine[]

  /// Recreated in SQL as NULLS NOT DISTINCT so system codes are unique too.
  @@unique([organizationId, code], map: "units_of_measure_code_key")
  @@map("units_of_measure")
}

enum ProductType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  PACKAGING
  CONSUMABLE
}

enum LotTracking {
  NONE
  LOT
  LOT_AND_EXPIRY
}

model Product {
  id                 String          @id @default(uuid(7)) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  sku                String
  nameEn             String          @map("name_en")
  nameAr             String?         @map("name_ar")
  type               ProductType
  baseUomId          String          @map("base_uom_id") @db.Uuid
  lotTracking        LotTracking     @default(NONE) @map("lot_tracking")
  shelfLifeDays      Int?            @map("shelf_life_days")
  storageRequirement TemperatureZone @default(AMBIENT) @map("storage_requirement")
  /// Receipts go to quarantine until a receiving inspection releases them (ADR-101).
  inspectOnReceipt   Boolean         @default(false) @map("inspect_on_receipt")
  /// Optional grouping for lists, reports and reorder planning (flat list, Q-13 default).
  categoryId         String?         @map("category_id") @db.Uuid
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdByUserId    String          @map("created_by_user_id") @db.Uuid
  updatedByUserId    String          @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Purchase tax code for supplier invoices; null = the organization's default.
  purchaseTaxCodeId String? @map("purchase_tax_code_id") @db.Uuid

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseTaxCode      TaxCode?                  @relation("ProductPurchaseTaxCode", fields: [organizationId, purchaseTaxCodeId], references: [organizationId, id], onDelete: Restrict)
  baseUom              UnitOfMeasure             @relation(fields: [baseUomId], references: [id], onDelete: Restrict)
  category             ProductCategory?          @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  barcodes             ProductBarcode[]
  conversions          ProductUomConversion[]
  lots                 InventoryLot[]
  ledgerEntries        InventoryLedgerEntry[]
  balances             StockBalance[]
  countLines           StockCountLine[]
  valuations           StockValuation[]
  revaluations         StockRevaluation[]
  supplierProducts     SupplierProduct[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  reorderRules         ReorderRule[]
  shipmentLines        StockShipmentLine[]
  requisitionLines     PurchaseRequisitionLine[]
  recipeIngredients    RecipeIngredient[]
  standardCosts        ProductStandardCost[]
  salesLines           SalesLine[]
  invoiceLines         SupplierInvoiceLine[]
  landedCostLines      LandedCostLine[]
  allergenDeclarations AllergenDeclaration[]
  nutritionProfiles    NutritionProfile[]
  referenceLinks       ReferenceFood[]           @relation("ReferenceLinkedProduct")
  producedBy           Recipe[]                  @relation("RecipeOutput")
  productionOrders     ProductionOrder[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]

  menuItems       MenuItem[]
  modifierOptions ModifierOption[]

  posShortfalls       PosConsumptionShortfall[]
  rfqLines            RfqLine[]
  supplierReturnLines SupplierReturnLine[]
  complaints          Complaint[]
  putawayRules        PutawayRule[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  /// Global search (ADR-088).
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_en_trgm")
  @@index([nameAr(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_ar_trgm")
  @@map("products")
}

enum BarcodeSymbology {
  EAN13
  EAN8
  UPC_A
  CODE128
  QR
  INTERNAL
}

model ProductBarcode {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  productId       String           @map("product_id") @db.Uuid
  barcode         String
  symbology       BarcodeSymbology
  /// Pack unit the barcode identifies (e.g. a case); NULL = the base unit.
  uomId           String?          @map("uom_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, barcode])
  @@map("product_barcodes")
}

/// Product-specific unit conversion: 1 uom = factor_to_base product base units.
model ProductUomConversion {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  uomId          String   @map("uom_id") @db.Uuid
  factorToBase   Decimal  @map("factor_to_base") @db.Decimal(30, 12)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, uomId])
  @@map("product_uom_conversions")
}

// ───────────────────────────── Inventory (Milestone 2) ─────────────────────────────

/// Lots are immutable once created (identity and dates are evidence for traceability).
model InventoryLot {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  lotCode         String    @map("lot_code")
  expiresOn       DateTime? @map("expires_on") @db.Date
  bestBeforeOn    DateTime? @map("best_before_on") @db.Date
  manufacturedOn  DateTime? @map("manufactured_on") @db.Date
  firstReceivedAt DateTime  @default(now()) @map("first_received_at") @db.Timestamptz(3)
  recallHold      Boolean   @default(false) @map("recall_hold")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  ledgerEntries InventoryLedgerEntry[]
  balances      StockBalance[]
  countLines    StockCountLine[]
  receiptLines  GoodsReceiptLine[]
  shipmentLines StockShipmentLine[]
  recallLots    RecallLot[]
  recallStock   RecallStock[]
  producedBy    ProductionOrder[]
  mockRecalls   MockRecall[]

  @@unique([organizationId, id])
  /// Lets ledger rows prove their lot belongs to their product.
  @@unique([organizationId, productId, id])
  @@unique([organizationId, productId, lotCode])
  /// Global search (ADR-088).
  @@index([lotCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "inventory_lots_lot_code_trgm")
  @@map("inventory_lots")
}

enum StockStatus {
  AVAILABLE
  QUARANTINE
  REJECTED
  ON_HOLD
  /// Dispatched on a shipment, held at the source warehouse until received (ADR-026).
  IN_TRANSIT
}

enum MovementType {
  OPENING_BALANCE
  RECEIPT
  RECEIPT_REJECTED
  TRANSFER_OUT
  TRANSFER_IN
  CONSUMPTION
  PRODUCTION_OUTPUT
  RETURN_TO_SUPPLIER
  CUSTOMER_RETURN
  WRITE_OFF
  ADJUSTMENT
  COUNT_ADJUSTMENT
  STATUS_CHANGE
  REVERSAL
  CUSTOMER_DELIVERY
}

enum InventoryDocumentType {
  OPENING_BALANCE
  ADJUSTMENT
  WRITE_OFF
  TRANSFER
  STATUS_CHANGE
  STOCK_COUNT
  REVERSAL
  REVALUATION
  RECEIPT
  DISPATCH
  TRANSIT_RECEIPT
  LANDED_COST
  CONSUMPTION
  PRODUCTION
  CUSTOMER_DELIVERY
  SUPPLIER_RETURN
}

/// How the unit cost of a ledger entry was determined (ADR-021).
enum CostSource {
  /// Cost entered with the movement (receipt price, opening balance cost).
  ENTERED
  /// Current (or last known) moving average of the product in the warehouse.
  AVERAGE
  /// Carried from the outbound leg of the same document (transfers, status changes).
  TRANSFER
  /// Put back at the cost it left with (reversal of an outbound movement).
  RESTORED
  /// No cost known: quantity added at zero value, product flagged cost missing.
  NONE
}

/// Header of one atomic posting. Immutable; corrected only by a REVERSAL document.
model InventoryDocument {
  id                     String                @id @default(uuid(7)) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  number                 String
  type                   InventoryDocumentType
  warehouseId            String                @map("warehouse_id") @db.Uuid
  destinationWarehouseId String?               @map("destination_warehouse_id") @db.Uuid
  reasonCode             String?               @map("reason_code")
  note                   String?
  reversesDocumentId     String?               @map("reverses_document_id") @db.Uuid
  occurredAt             DateTime              @map("occurred_at") @db.Timestamptz(3)
  postedAt               DateTime              @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedByUserId         String                @map("posted_by_user_id") @db.Uuid

  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse                Warehouse              @relation("DocumentWarehouse", fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  destination              Warehouse?             @relation("DocumentDestination", fields: [organizationId, destinationWarehouseId], references: [organizationId, id], onDelete: Restrict)
  reverses                 InventoryDocument?     @relation("DocumentReversal", fields: [organizationId, reversesDocumentId], references: [organizationId, id], onDelete: Restrict)
  reversedBy               InventoryDocument?     @relation("DocumentReversal")
  entries                  InventoryLedgerEntry[]
  stockCount               StockCount?
  revaluation              StockRevaluation?
  receipt                  GoodsReceipt?          @relation("ReceiptDocument")
  receiptReversal          GoodsReceipt?          @relation("ReceiptReversal")
  shipmentDispatch         StockShipment?         @relation("ShipmentDispatch")
  shipmentReceipt          StockShipment?         @relation("ShipmentReceipt")
  shipmentCancel           StockShipment?         @relation("ShipmentCancel")
  landedCost               LandedCost?            @relation("LandedCostDocument")
  recallDocument           RecallDocument?
  salesImport              SalesImport?           @relation("SalesConsumption")
  salesReversal            SalesImport?           @relation("SalesReversal")
  productionOrder          ProductionOrder?       @relation("ProductionDocument")
  productionReversal       ProductionOrder?       @relation("ProductionReversal")
  customerDelivery         CustomerDelivery?      @relation("DeliveryDocument")
  customerDeliveryReversal CustomerDelivery?      @relation("DeliveryReversal")
  supplierReturnPostings   SupplierReturn[]       @relation("SupplierReturnPosting")
  supplierReturnReversals  SupplierReturn[]       @relation("SupplierReturnReversal")
  receiptInspections       ReceiptInspection[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  /// A document can be reversed at most once.
  @@unique([organizationId, reversesDocumentId])
  @@index([organizationId, postedAt(sort: Desc)])
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "inventory_documents_number_trgm")
  @@map("inventory_documents")
}

/// Append-only stock ledger (UPDATE/DELETE/TRUNCATE rejected by trigger).
/// Quantities are in the product's base unit; entered_* keep what the user typed.
model InventoryLedgerEntry {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  documentId      String       @map("document_id") @db.Uuid
  movementType    MovementType @map("movement_type")
  warehouseId     String       @map("warehouse_id") @db.Uuid
  locationId      String?      @map("location_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  lotId           String?      @map("lot_id") @db.Uuid
  stockStatus     StockStatus  @map("stock_status")
  quantityDelta   Decimal      @map("quantity_delta") @db.Decimal(20, 6)
  enteredQuantity Decimal      @map("entered_quantity") @db.Decimal(20, 6)
  enteredUomId    String       @map("entered_uom_id") @db.Uuid
  /// Base currency per base unit used to value this entry (null only when cost_source = NONE).
  unitCost        Decimal?     @map("unit_cost") @db.Decimal(20, 6)
  /// Signed change in stock value, base currency (ADR-021).
  valueDelta      Decimal      @map("value_delta") @db.Decimal(19, 4)
  costSource      CostSource   @map("cost_source")
  sourceType      String       @map("source_type")
  sourceId        String       @map("source_id") @db.Uuid
  sourceLineId    String?      @map("source_line_id") @db.Uuid
  /// Deterministic idempotency key, e.g. "transfer:<docId>:1:out".
  postingKey      String       @map("posting_key")
  reversesEntryId String?      @map("reverses_entry_id") @db.Uuid
  reasonCode      String?      @map("reason_code")
  note            String?
  occurredAt      DateTime     @map("occurred_at") @db.Timestamptz(3)
  postedAt        DateTime     @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedByUserId  String       @map("posted_by_user_id") @db.Uuid

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     InventoryDocument     @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse             @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  location     StorageLocation?      @relation(fields: [organizationId, warehouseId, locationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  product      Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  lot          InventoryLot?         @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  enteredUom   UnitOfMeasure         @relation(fields: [enteredUomId], references: [id], onDelete: Restrict)
  reverses     InventoryLedgerEntry? @relation("EntryReversal", fields: [organizationId, reversesEntryId], references: [organizationId, id], onDelete: Restrict)
  reversedBy   InventoryLedgerEntry? @relation("EntryReversal")

  @@unique([organizationId, id])
  @@unique([organizationId, postingKey])
  @@unique([organizationId, reversesEntryId])
  @@index([organizationId, productId, warehouseId, postedAt])
  @@index([organizationId, lotId])
  @@index([organizationId, documentId])
  @@index([organizationId, postedAt(sort: Desc)])
  @@map("inventory_ledger_entries")
}

/// Projection of the ledger, updated in the same transaction under row locks.
/// CHECK constraints (no negative stock) are in SQL.
model StockBalance {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  warehouseId      String      @map("warehouse_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  lotId            String?     @map("lot_id") @db.Uuid
  stockStatus      StockStatus @map("stock_status")
  onHandQuantity   Decimal     @default(0) @map("on_hand_quantity") @db.Decimal(20, 6)
  reservedQuantity Decimal     @default(0) @map("reserved_quantity") @db.Decimal(20, 6)
  lastEntryId      String?     @map("last_entry_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  location     StorageLocation? @relation(fields: [organizationId, warehouseId, locationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  lot          InventoryLot?    @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  /// The bucket key. Recreated in SQL as NULLS NOT DISTINCT.
  @@unique([organizationId, warehouseId, locationId, productId, lotId, stockStatus], map: "stock_balances_bucket_key")
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@map("stock_balances")
}

/// Moving weighted average valuation per product × warehouse (ADR-021).
/// Written only by the posting engine; quantity equals the sum of on-hand
/// balances of the product in the warehouse across locations, lots and statuses.
model StockValuation {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Decimal  @default(0) @db.Decimal(20, 6)
  totalValue      Decimal  @default(0) @map("total_value") @db.Decimal(19, 4)
  /// Current average, or the last known one when quantity is zero.
  averageUnitCost Decimal? @map("average_unit_cost") @db.Decimal(20, 6)
  /// Some quantity was added with no known cost; cleared by revaluation or when stock reaches zero.
  costMissing     Boolean  @default(false) @map("cost_missing")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, warehouseId, productId])
  @@index([organizationId, productId])
  @@map("stock_valuations")
}

/// A change of average cost without a quantity movement. Append-only.
model StockRevaluation {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  documentId          String   @map("document_id") @db.Uuid
  warehouseId         String   @map("warehouse_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Decimal  @db.Decimal(20, 6)
  previousUnitCost    Decimal? @map("previous_unit_cost") @db.Decimal(20, 6)
  newUnitCost         Decimal  @map("new_unit_cost") @db.Decimal(20, 6)
  previousValue       Decimal  @map("previous_value") @db.Decimal(19, 4)
  newValue            Decimal  @map("new_value") @db.Decimal(19, 4)
  valueDelta          Decimal  @map("value_delta") @db.Decimal(19, 4)
  previousCostMissing Boolean  @map("previous_cost_missing")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     InventoryDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse         @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, documentId])
  @@index([organizationId, productId, warehouseId])
  @@map("stock_revaluations")
}

/// Per-organization, per-type, per-year counters for human-readable document numbers.
model DocumentSequence {
  organizationId String @map("organization_id") @db.Uuid
  documentType   String @map("document_type")
  year           Int
  nextValue      Int    @map("next_value")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, documentType, year])
  @@map("document_sequences")
}

enum StockCountStatus {
  OPEN
  SUBMITTED
  POSTED
  CANCELLED
}

model StockCount {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  number               String
  warehouseId          String           @map("warehouse_id") @db.Uuid
  /// Optional: count only one location of the warehouse.
  locationId           String?          @map("location_id") @db.Uuid
  status               StockCountStatus @default(OPEN)
  snapshotAt           DateTime         @default(now()) @map("snapshot_at") @db.Timestamptz(3)
  note                 String?
  documentId           String?          @map("document_id") @db.Uuid
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  submittedByUserId    String?          @map("submitted_by_user_id") @db.Uuid
  submittedAt          DateTime?        @map("submitted_at") @db.Timestamptz(3)
  postedByUserId       String?          @map("posted_by_user_id") @db.Uuid
  postedAt             DateTime?        @map("posted_at") @db.Timestamptz(3)
  cancelledAt          DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  /// Value of the differences (sum of |counted − system| × average cost, base currency), at submission.
  varianceValue        Decimal?         @map("variance_value") @db.Decimal(19, 4)
  /// Approval chain (ADR-049, Q-12), as for purchase orders.
  approvalRound        Int              @default(0) @map("approval_round")
  approvalChain        ApprovalLevel[]  @default([]) @map("approval_chain")
  approvalsGiven       Int              @default(0) @map("approvals_given")
  pendingApprovalLevel ApprovalLevel?   @map("pending_approval_level")
  rejectionNote        String?          @map("rejection_note")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse            @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  location     StorageLocation?     @relation(fields: [organizationId, warehouseId, locationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  document     InventoryDocument?   @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  lines        StockCountLine[]
  approvals    StockCountApproval[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, documentId])
  @@index([organizationId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  countId          String    @map("count_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  lotId            String?   @map("lot_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  expectedQuantity Decimal   @map("expected_quantity") @db.Decimal(20, 6)
  countedQuantity  Decimal?  @map("counted_quantity") @db.Decimal(20, 6)
  countedByUserId  String?   @map("counted_by_user_id") @db.Uuid
  countedAt        DateTime? @map("counted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  count        StockCount       @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  lot          InventoryLot?    @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  location     StorageLocation? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  /// Recreated in SQL as NULLS NOT DISTINCT.
  @@unique([countId, productId, lotId, locationId], map: "stock_count_lines_item_key")
  @@index([organizationId, countId])
  @@map("stock_count_lines")
}

// ─── Procurement (Milestone 3b) ───

/// A supplier of one organization.
enum ExchangeRateSource {
  MANUAL
  CSV
}

/// Base-currency units for one unit of `currency` on `rate_date` (ADR-050).
/// Documents copy the rate they use, so later corrections never change them.
model ExchangeRate {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  currency        String             @db.Char(3)
  rateDate        DateTime           @map("rate_date") @db.Date
  rate            Decimal            @db.Decimal(20, 10)
  source          ExchangeRateSource @default(MANUAL)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, currency, rateDate])
  @@map("exchange_rates")
}

/// Documents that can carry attachments (ADR-051).
enum AttachmentEntity {
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_INVOICE
  SUPPLIER_SETTLEMENT
  STOCK_COUNT
  SUPPLIER_DOCUMENT
  QUOTATION
  FS_DOCUMENT_VERSION
  CALIBRATION
}

/// A file attached to a document (ADR-051, Q-08): at most 3 MB, kept until
/// `retain_until` (3 years), then its content is purged and this record kept.
enum AttachmentScanStatus {
  CLEAN
  NOT_SCANNED
}

model Attachment {
  id               String               @id @default(uuid(7)) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  entityType       AttachmentEntity     @map("entity_type")
  entityId         String               @map("entity_id") @db.Uuid
  fileName         String               @map("file_name")
  contentType      String               @map("content_type")
  sizeBytes        Int                  @map("size_bytes")
  sha256           String
  /// CLEAN when ClamAV found nothing; NOT_SCANNED when no scanner is configured (ADR-055).
  scanStatus       AttachmentScanStatus @default(NOT_SCANNED) @map("scan_status")
  scannedAt        DateTime?            @map("scanned_at") @db.Timestamptz(3)
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  retainUntil      DateTime             @map("retain_until") @db.Date
  /// Removed by its uploader shortly after upload (a mistaken file), or purged after retention.
  removedAt        DateTime?            @map("removed_at") @db.Timestamptz(3)
  removedByUserId  String?              @map("removed_by_user_id") @db.Uuid
  purgedAt         DateTime?            @map("purged_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  content      AttachmentContent?

  @@unique([organizationId, id])
  @@index([organizationId, entityType, entityId])
  @@index([retainUntil])
  @@map("attachments")
}

/// The bytes of an attachment, kept apart so listings never load them.
model AttachmentContent {
  attachmentId   String @id @map("attachment_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  data           Bytes

  attachment Attachment @relation(fields: [organizationId, attachmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, attachmentId])
  @@map("attachment_contents")
}

/// A period-end revaluation of open foreign-currency payables (ADR-052):
/// unrealised exchange differences at the rate on `as_of`, reversed the next day.
model FxRevaluation {
  id                        String    @id @default(uuid(7)) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  number                    String
  /// One company's balances, in its currency (ADR-086). Set by the database when omitted.
  companyId                 String?   @map("company_id") @db.Uuid
  asOf                      DateTime  @map("as_of") @db.Date
  /// Σ differences, base currency: + = the payables grew (loss).
  totalDifferenceBase       Decimal   @map("total_difference_base") @db.Decimal(19, 4)
  /// Σ differences on customer balances, base currency: + = receivables grew (gain) (ADR-056).
  receivablesDifferenceBase Decimal   @default(0) @map("receivables_difference_base") @db.Decimal(19, 4)
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt               DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId         String?   @map("cancelled_by_user_id") @db.Uuid
  cancelReason              String?   @map("cancel_reason")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company?            @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  lines        FxRevaluationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@map("fx_revaluations")
}

model FxRevaluationLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  revaluationId  String   @map("revaluation_id") @db.Uuid
  supplierId     String?  @map("supplier_id") @db.Uuid
  /// Exactly one of supplier (payable) or customer (receivable).
  customerId     String?  @map("customer_id") @db.Uuid
  currency       String   @db.Char(3)
  /// Open balance in the currency (invoices − settlements), and its booked base value.
  openAmount     Decimal  @map("open_amount") @db.Decimal(19, 4)
  bookedBase     Decimal  @map("booked_base") @db.Decimal(19, 4)
  rate           Decimal  @db.Decimal(20, 10)
  rateDate       DateTime @map("rate_date") @db.Date
  revaluedBase   Decimal  @map("revalued_base") @db.Decimal(19, 4)
  differenceBase Decimal  @map("difference_base") @db.Decimal(19, 4)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  revaluation  FxRevaluation @relation(fields: [organizationId, revaluationId], references: [organizationId, id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  customer Customer? @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, revaluationId])
  @@map("fx_revaluation_lines")
}

model Supplier {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  code             String
  name             String
  nameAr           String?        @map("name_ar")
  taxId            String?        @map("tax_id")
  contactName      String?        @map("contact_name")
  email            String?
  phone            String?
  address          String?
  paymentTermsDays Int?           @map("payment_terms_days")
  leadTimeDays     Int?           @map("lead_time_days")
  /// Default currency of this supplier's documents (ADR-050); null = base currency.
  currency         String?        @db.Char(3)
  note             String?
  /// Approval and blocking (ADR-091). Orders can be sent only to APPROVED suppliers.
  status           SupplierStatus @default(APPROVED)
  /// Who created the supplier: the approver must be someone else (ADR-091). Null before C1a.
  createdByUserId  String?        @map("created_by_user_id") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(3)
  approvedByUserId String?        @map("approved_by_user_id") @db.Uuid
  blockedAt        DateTime?      @map("blocked_at") @db.Timestamptz(3)
  blockedByUserId  String?        @map("blocked_by_user_id") @db.Uuid
  blockedReason    String?        @map("blocked_reason")
  archivedAt       DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents          SupplierDocument[]
  bankAccounts       SupplierBankAccount[]
  rfqInvitations     RfqSupplier[]
  returns            SupplierReturn[]
  quotations         Quotation[]
  products           SupplierProduct[]
  purchaseOrders     PurchaseOrder[]
  receipts           GoodsReceipt[]
  invoices           SupplierInvoice[]
  settlements        SupplierSettlement[]
  fxRevaluationLines FxRevaluationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  /// Global search (ADR-088).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm")
  @@map("suppliers")
}

enum SupplierStatus {
  PENDING_APPROVAL
  APPROVED
  BLOCKED
}

enum SupplierDocumentType {
  COMMERCIAL_REGISTRATION
  VAT_CERTIFICATE
  MUNICIPALITY_LICENSE
  FOOD_SAFETY_CERTIFICATE
  HALAL_CERTIFICATE
  ISO_CERTIFICATE
  INSURANCE
  CONTRACT
  OTHER
}

/// A supplier's licence, certificate or contract with its expiry (ADR-091).
/// When `requiredToBuy` and expired, orders to the supplier cannot be submitted or approved.
model SupplierDocument {
  id               String               @id @default(uuid(7)) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  supplierId       String               @map("supplier_id") @db.Uuid
  type             SupplierDocumentType
  /// Required for OTHER; otherwise an optional label.
  title            String?
  number           String?
  issuedOn         DateTime?            @map("issued_on") @db.Date
  expiresOn        DateTime?            @map("expires_on") @db.Date
  requiredToBuy    Boolean              @default(false) @map("required_to_buy")
  note             String?
  createdByUserId  String               @map("created_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(3)
  archivedByUserId String?              @map("archived_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, supplierId])
  @@index([organizationId, expiresOn])
  @@map("supplier_documents")
}

enum SupplierBankAccountKind {
  IBAN
  ACCOUNT_NUMBER
}

/// Where a supplier is paid (ADR-091). The account number is stored encrypted
/// (AES-256-GCM) with only its last four characters in clear. The number never
/// changes: a new account is added and the old one archived. An account is
/// usable once someone other than the person who added it has verified it.
model SupplierBankAccount {
  id               String                  @id @default(uuid(7)) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  supplierId       String                  @map("supplier_id") @db.Uuid
  bankName         String                  @map("bank_name")
  accountName      String                  @map("account_name")
  kind             SupplierBankAccountKind
  accountSealed    String                  @map("account_sealed")
  accountLast4     String                  @map("account_last4")
  swiftBic         String?                 @map("swift_bic")
  currency         String?                 @db.Char(3)
  createdByUserId  String                  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt       DateTime?               @map("verified_at") @db.Timestamptz(3)
  verifiedByUserId String?                 @map("verified_by_user_id") @db.Uuid
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(3)
  archivedByUserId String?                 @map("archived_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, supplierId])
  @@map("supplier_bank_accounts")
}

/// A product a supplier sells, in the unit it is ordered in, with the last price paid.
model SupplierProduct {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  supplierSku      String?   @map("supplier_sku")
  purchaseUomId    String    @map("purchase_uom_id") @db.Uuid
  /// Per purchase unit, in the supplier's currency (ADR-050). Updated from posted receipts.
  lastUnitPrice    Decimal?  @map("last_unit_price") @db.Decimal(20, 6)
  lastPriceAt      DateTime? @map("last_price_at") @db.Timestamptz(3)
  leadTimeDays     Int?      @map("lead_time_days")
  minOrderQuantity Decimal?  @map("min_order_quantity") @db.Decimal(20, 6)
  preferred        Boolean   @default(false)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier      @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  product      Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  purchaseUom  UnitOfMeasure @relation(fields: [purchaseUomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, supplierId, productId])
  @@index([organizationId, productId])
  @@map("supplier_products")
}

/// Purchasing rules of one organization (DECISIONS.md ADR-023).
model ProcurementSettings {
  organizationId           String   @id @map("organization_id") @db.Uuid
  /// Fraction 0–1 by which accepted quantity may exceed the ordered quantity.
  overReceiptTolerance     Decimal  @default(0) @map("over_receipt_tolerance") @db.Decimal(9, 6)
  /// Fraction 0–1 by which an invoice unit price may differ from the order price (ADR-038).
  invoicePriceTolerance    Decimal  @default(0) @map("invoice_price_tolerance") @db.Decimal(9, 6)
  /// New suppliers wait for approval before orders can be sent to them (ADR-091).
  supplierApprovalRequired Boolean  @default(false) @map("supplier_approval_required")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("procurement_settings")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid(7)) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId            String?             @map("company_id") @db.Uuid
  number               String
  supplierId           String              @map("supplier_id") @db.Uuid
  warehouseId          String              @map("warehouse_id") @db.Uuid
  status               PurchaseOrderStatus @default(DRAFT)
  currency             String              @db.Char(3)
  expectedOn           DateTime?           @map("expected_on") @db.Date
  note                 String?
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(19, 4)
  /// Rate (base per unit of `currency`) and base total fixed at submission (ADR-050).
  exchangeRate         Decimal?            @map("exchange_rate") @db.Decimal(20, 10)
  totalAmountBase      Decimal?            @map("total_amount_base") @db.Decimal(19, 4)
  createdByUserId      String              @map("created_by_user_id") @db.Uuid
  submittedAt          DateTime?           @map("submitted_at") @db.Timestamptz(3)
  submittedByUserId    String?             @map("submitted_by_user_id") @db.Uuid
  approvedAt           DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedByUserId     String?             @map("approved_by_user_id") @db.Uuid
  /// True when submission approved the order automatically (no threshold or below it).
  autoApproved         Boolean             @default(false) @map("auto_approved")
  rejectionNote        String?             @map("rejection_note")
  /// Approval chain (ADR-049): fixed at submission; the round counts submissions.
  approvalRound        Int                 @default(0) @map("approval_round")
  /// Levels this submission must pass, fixed at submission from the approval layers.
  approvalChain        ApprovalLevel[]     @default([]) @map("approval_chain")
  approvalsGiven       Int                 @default(0) @map("approvals_given")
  /// Level of the next step while PENDING_APPROVAL.
  pendingApprovalLevel ApprovalLevel?      @map("pending_approval_level")
  closedAt             DateTime?           @map("closed_at") @db.Timestamptz(3)
  closedByUserId       String?             @map("closed_by_user_id") @db.Uuid
  closeReason          String?             @map("close_reason")
  /// Created by awarding this quotation (ADR-092).
  quotationId          String?             @map("quotation_id") @db.Uuid
  /// Version of the order (ADR-093): 0 as first approved; each revision adds one.
  revision             Int                 @default(0)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotation    Quotation?              @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Restrict)
  supplier     Supplier                @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse               @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]
  approvals    PurchaseOrderApproval[]
  revisions    PurchaseOrderRevision[]

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "purchase_orders_number_trgm")
  @@map("purchase_orders")
}

/// BRANCH: by a branch- or warehouse-scoped approver of the order's site;
/// HEAD_OFFICE: by an organization-wide approver; ANY: either (single step).
enum ApprovalLevel {
  BRANCH
  HEAD_OFFICE
  ANY
}

/// Document types with an approval matrix.
enum ApprovalDocument {
  PURCHASE_ORDER
  STOCK_COUNT
}

/// One layer of an organization's approval matrix (ADR-049): positions 1–3
/// branch, 4 head office; required when the amount is above above_amount.
/// No row = layer not used.
model ApprovalLayer {
  organizationId String           @map("organization_id") @db.Uuid
  document       ApprovalDocument
  position       Int
  aboveAmount    Decimal          @map("above_amount") @db.Decimal(19, 4)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, document, position])
  @@map("approval_layers")
}

/// One approval step of a stock count (insert-only), as for purchase orders.
model StockCountApproval {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  countId          String        @map("count_id") @db.Uuid
  round            Int
  step             Int
  level            ApprovalLevel
  approvedByUserId String        @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime      @default(now()) @map("approved_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  count        StockCount   @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, countId, round, step], map: "count_approvals_step_key")
  @@unique([organizationId, countId, round, approvedByUserId], map: "count_approvals_person_key")
  @@map("stock_count_approvals")
}

/// One approval step of one submission round (insert-only).
model PurchaseOrderApproval {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  round            Int
  step             Int
  level            ApprovalLevel
  approvedByUserId String        @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime      @default(now()) @map("approved_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, purchaseOrderId, round, step], map: "po_approvals_step_key")
  @@unique([organizationId, purchaseOrderId, round, approvedByUserId], map: "po_approvals_person_key")
  @@map("purchase_order_approvals")
}

/// The version an order had when a revision was started (ADR-093): header and
/// lines as approved, and why it was revised. Written once, never changed.
model PurchaseOrderRevision {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  /// The version kept here (the order moves on to revision + 1).
  revision        Int
  reason          String
  /// { expectedOn, note, currency, totalAmount, approvedAt, approvedByUserId, lines: [{ lineNo, productId, uomId, quantity, unitPrice, lineTotal }] }
  snapshot        Json
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderId, revision])
  @@map("purchase_order_revisions")
}

model PurchaseOrderLine {
  id                   String  @id @default(uuid(7)) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  purchaseOrderId      String  @map("purchase_order_id") @db.Uuid
  lineNo               Int     @map("line_no")
  productId            String  @map("product_id") @db.Uuid
  uomId                String  @map("uom_id") @db.Uuid
  /// Ordered quantity in uom_id, and the same in the product's base unit.
  quantity             Decimal @db.Decimal(20, 6)
  quantityBase         Decimal @map("quantity_base") @db.Decimal(20, 6)
  /// Per uom_id, base currency.
  unitPrice            Decimal @map("unit_price") @db.Decimal(20, 6)
  lineTotal            Decimal @map("line_total") @db.Decimal(19, 4)
  /// Accepted so far, base unit; maintained by receiving under the order's row lock.
  receivedQuantityBase Decimal @default(0) @map("received_quantity_base") @db.Decimal(20, 6)
  note                 String?

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder            @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  product         Product                  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom             UnitOfMeasure            @relation(fields: [uomId], references: [id], onDelete: Restrict)
  receiptLines    GoodsReceiptLine[]
  requisitionLine PurchaseRequisitionLine?
  invoiceLines    SupplierInvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderId, lineNo])
  @@unique([organizationId, purchaseOrderId, productId])
  @@map("purchase_order_lines")
}

enum GoodsReceiptStatus {
  POSTED
  REVERSED
}

/// A delivery received against a purchase order. Posted when created.
model GoodsReceipt {
  id                  String             @id @default(uuid(7)) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId           String?            @map("company_id") @db.Uuid
  number              String
  purchaseOrderId     String             @map("purchase_order_id") @db.Uuid
  supplierId          String             @map("supplier_id") @db.Uuid
  warehouseId         String             @map("warehouse_id") @db.Uuid
  locationId          String?            @map("location_id") @db.Uuid
  status              GoodsReceiptStatus @default(POSTED)
  /// Stock posting; null when every line was rejected.
  inventoryDocumentId String?            @map("inventory_document_id") @db.Uuid
  reversalDocumentId  String?            @map("reversal_document_id") @db.Uuid
  deliveryNoteRef     String?            @map("delivery_note_ref")
  note                String?
  receivedAt          DateTime           @map("received_at") @db.Timestamptz(3)
  /// The order's currency; prices are in it, stock is valued at price × rate (ADR-050).
  currency            String             @db.Char(3)
  exchangeRate        Decimal            @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate            DateTime?          @map("rate_date") @db.Date
  postedByUserId      String             @map("posted_by_user_id") @db.Uuid
  reversedAt          DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedByUserId    String?            @map("reversed_by_user_id") @db.Uuid
  reversalReason      String?            @map("reversal_reason")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  location      StorageLocation?   @relation(fields: [organizationId, warehouseId, locationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  document      InventoryDocument? @relation("ReceiptDocument", fields: [organizationId, inventoryDocumentId], references: [organizationId, id], onDelete: Restrict)
  reversal      InventoryDocument? @relation("ReceiptReversal", fields: [organizationId, reversalDocumentId], references: [organizationId, id], onDelete: Restrict)
  lines         GoodsReceiptLine[]
  landedCosts   LandedCost[]

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, inventoryDocumentId])
  @@unique([organizationId, reversalDocumentId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, supplierId, receivedAt])
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "goods_receipts_number_trgm")
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  receiptId            String   @map("receipt_id") @db.Uuid
  purchaseOrderLineId  String   @map("purchase_order_line_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  /// Quantities are in the order line's unit; *_base in the product's base unit.
  uomId                String   @map("uom_id") @db.Uuid
  receivedQuantity     Decimal  @map("received_quantity") @db.Decimal(20, 6)
  acceptedQuantity     Decimal  @map("accepted_quantity") @db.Decimal(20, 6)
  rejectedQuantity     Decimal  @map("rejected_quantity") @db.Decimal(20, 6)
  acceptedQuantityBase Decimal  @map("accepted_quantity_base") @db.Decimal(20, 6)
  rejectedQuantityBase Decimal  @map("rejected_quantity_base") @db.Decimal(20, 6)
  rejectionReason      String?  @map("rejection_reason")
  quarantine           Boolean  @default(false)
  lotId                String?  @map("lot_id") @db.Uuid
  /// Price charged per uom_id (may differ from the order), and the order price at receipt.
  unitPrice            Decimal  @map("unit_price") @db.Decimal(20, 6)
  orderedUnitPrice     Decimal  @map("ordered_unit_price") @db.Decimal(20, 6)
  temperatureCelsius   Decimal? @map("temperature_celsius") @db.Decimal(5, 1)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt           GoodsReceipt          @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine     @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict)
  product           Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom               UnitOfMeasure         @relation(fields: [uomId], references: [id], onDelete: Restrict)
  lot               InventoryLot?         @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  landedCostLines   LandedCostLine[]
  invoiceLines      SupplierInvoiceLine[]
  returnLines       SupplierReturnLine[]
  inspection        ReceiptInspection?

  @@unique([organizationId, id])
  @@index([organizationId, receiptId])
  @@index([organizationId, purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

enum SupplierReturnStatus {
  DRAFT
  POSTED
  CREDITED
  REVERSED
  CANCELLED
}

enum SupplierReturnReason {
  QUALITY
  DAMAGED
  EXPIRED
  WRONG_ITEM
  RECALL
  OVERSUPPLY
  OTHER
}

/// Goods sent back to a supplier after they were received (ADR-094). Lines come
/// from posted receipt lines (product, lot, unit, charged price). Posting takes
/// the stock out through the ledger (RETURN_TO_SUPPLIER); the supplier's credit
/// note is then linked to close it.
model SupplierReturn {
  id                  String               @id @default(uuid(7)) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  number              String
  supplierId          String               @map("supplier_id") @db.Uuid
  warehouseId         String               @map("warehouse_id") @db.Uuid
  /// The receipts' currency: the expected credit is in it.
  currency            String               @db.Char(3)
  status              SupplierReturnStatus @default(DRAFT)
  reason              SupplierReturnReason
  note                String?
  /// Expected credit: Σ quantity × charged price (excl. VAT).
  totalAmount         Decimal              @default(0) @map("total_amount") @db.Decimal(19, 4)
  inventoryDocumentId String?              @map("inventory_document_id") @db.Uuid
  reversalDocumentId  String?              @map("reversal_document_id") @db.Uuid
  creditNoteId        String?              @map("credit_note_id") @db.Uuid
  createdByUserId     String               @map("created_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  postedAt            DateTime?            @map("posted_at") @db.Timestamptz(3)
  postedByUserId      String?              @map("posted_by_user_id") @db.Uuid
  creditedAt          DateTime?            @map("credited_at") @db.Timestamptz(3)
  creditedByUserId    String?              @map("credited_by_user_id") @db.Uuid
  /// Cancelled (draft) or reversed (posted): who, when, why.
  decidedAt           DateTime?            @map("decided_at") @db.Timestamptz(3)
  decidedByUserId     String?              @map("decided_by_user_id") @db.Uuid
  decisionReason      String?              @map("decision_reason")
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier          Supplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  warehouse         Warehouse            @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  inventoryDocument InventoryDocument?   @relation("SupplierReturnPosting", fields: [organizationId, inventoryDocumentId], references: [organizationId, id], onDelete: Restrict)
  reversalDocument  InventoryDocument?   @relation("SupplierReturnReversal", fields: [organizationId, reversalDocumentId], references: [organizationId, id], onDelete: Restrict)
  creditNote        SupplierSettlement?  @relation(fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Restrict)
  lines             SupplierReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  returnId       String      @map("return_id") @db.Uuid
  lineNo         Int         @map("line_no")
  receiptLineId  String      @map("receipt_line_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  lotId          String?     @map("lot_id") @db.Uuid
  /// The receipt line's unit; quantity_base in the product's base unit.
  uomId          String      @map("uom_id") @db.Uuid
  quantity       Decimal     @db.Decimal(20, 6)
  quantityBase   Decimal     @map("quantity_base") @db.Decimal(20, 6)
  /// The price charged on the receipt, per uom_id, in the return's currency.
  unitPrice      Decimal     @map("unit_price") @db.Decimal(20, 6)
  lineTotal      Decimal     @map("line_total") @db.Decimal(19, 4)
  /// Taken from available stock or from quarantine.
  fromStatus     StockStatus @map("from_status")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierReturn SupplierReturn   @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Cascade)
  receiptLine    GoodsReceiptLine @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  product        Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom            UnitOfMeasure    @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, lineNo])
  @@unique([organizationId, returnId, receiptLineId])
  @@index([organizationId, receiptLineId])
  @@map("supplier_return_lines")
}

// ─── Catalog categories and reorder planning (Milestone 3c) ───

/// Flat product category list per organization.
model ProductCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  nameAr         String?   @map("name_ar")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]
  putawayRules PutawayRule[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("product_categories")
}

/// Reorder level (par level) of a product in a warehouse, in the product's base unit.
/// When available + on-order stock falls to the minimum, an order up to the maximum is suggested.
model ReorderRule {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  minQuantityBase Decimal  @map("min_quantity_base") @db.Decimal(20, 6)
  maxQuantityBase Decimal  @map("max_quantity_base") @db.Decimal(20, 6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, warehouseId, productId])
  @@map("reorder_rules")
}

// ─── In-transit transfers (Milestone 3c) ───

enum ShipmentStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/// Stock sent between warehouses with a dispatch → receive gap (ADR-026).
model StockShipment {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  number             String
  fromWarehouseId    String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId      String         @map("to_warehouse_id") @db.Uuid
  /// Where the stock is put away at the destination (optional).
  toLocationId       String?        @map("to_location_id") @db.Uuid
  status             ShipmentStatus @default(DRAFT)
  expectedOn         DateTime?      @map("expected_on") @db.Date
  note               String?
  dispatchDocumentId String?        @map("dispatch_document_id") @db.Uuid
  receiptDocumentId  String?        @map("receipt_document_id") @db.Uuid
  cancelDocumentId   String?        @map("cancel_document_id") @db.Uuid
  createdByUserId    String         @map("created_by_user_id") @db.Uuid
  dispatchedAt       DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  dispatchedByUserId String?        @map("dispatched_by_user_id") @db.Uuid
  receivedAt         DateTime?      @map("received_at") @db.Timestamptz(3)
  receivedByUserId   String?        @map("received_by_user_id") @db.Uuid
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId  String?        @map("cancelled_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  from             Warehouse                 @relation("ShipmentFrom", fields: [organizationId, fromWarehouseId], references: [organizationId, id], onDelete: Restrict)
  to               Warehouse                 @relation("ShipmentTo", fields: [organizationId, toWarehouseId], references: [organizationId, id], onDelete: Restrict)
  toLocation       StorageLocation?          @relation(fields: [organizationId, toWarehouseId, toLocationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  dispatchDoc      InventoryDocument?        @relation("ShipmentDispatch", fields: [organizationId, dispatchDocumentId], references: [organizationId, id], onDelete: Restrict)
  receiptDoc       InventoryDocument?        @relation("ShipmentReceipt", fields: [organizationId, receiptDocumentId], references: [organizationId, id], onDelete: Restrict)
  cancelDoc        InventoryDocument?        @relation("ShipmentCancel", fields: [organizationId, cancelDocumentId], references: [organizationId, id], onDelete: Restrict)
  lines            StockShipmentLine[]
  requisitionLines PurchaseRequisitionLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, dispatchDocumentId])
  @@unique([organizationId, receiptDocumentId])
  @@unique([organizationId, cancelDocumentId])
  @@index([organizationId, status])
  @@map("stock_shipments")
}

model StockShipmentLine {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  shipmentId           String   @map("shipment_id") @db.Uuid
  lineNo               Int      @map("line_no")
  productId            String   @map("product_id") @db.Uuid
  lotId                String?  @map("lot_id") @db.Uuid
  /// Source location the stock is taken from.
  fromWarehouseId      String   @map("from_warehouse_id") @db.Uuid
  fromLocationId       String?  @map("from_location_id") @db.Uuid
  uomId                String   @map("uom_id") @db.Uuid
  quantity             Decimal  @db.Decimal(20, 6)
  quantityBase         Decimal  @map("quantity_base") @db.Decimal(20, 6)
  /// Set when received; the rest (if any) is a recorded shortage.
  receivedQuantityBase Decimal? @map("received_quantity_base") @db.Decimal(20, 6)
  shortageReason       String?  @map("shortage_reason")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipment     StockShipment    @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Cascade)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  lot          InventoryLot?    @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  fromLocation StorageLocation? @relation(fields: [organizationId, fromWarehouseId, fromLocationId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  uom          UnitOfMeasure    @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, shipmentId, lineNo])
  @@map("stock_shipment_lines")
}

// ─── Landed cost (Milestone 3c, ADR-028) ───

enum LandedCostCharge {
  FREIGHT
  CUSTOMS_DUTY
  INSURANCE
  HANDLING
  OTHER
}

enum LandedCostMethod {
  BY_VALUE
  BY_QUANTITY
}

/// A charge (freight, duty, …) added to the cost of a posted goods receipt. Append-only.
model LandedCost {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  receiptId         String           @map("receipt_id") @db.Uuid
  /// The LANDED_COST inventory document (its number identifies the charge).
  documentId        String           @map("document_id") @db.Uuid
  warehouseId       String           @map("warehouse_id") @db.Uuid
  chargeType        LandedCostCharge @map("charge_type")
  method            LandedCostMethod
  amount            Decimal          @db.Decimal(19, 4)
  /// As entered: currency, amount and the rate on the posting date (ADR-053); `amount` is base currency.
  currency          String           @db.Char(3)
  enteredAmount     Decimal          @map("entered_amount") @db.Decimal(19, 4)
  exchangeRate      Decimal          @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate          DateTime?        @map("rate_date") @db.Date
  /// Added to stock still on hand; the rest relates to stock already used.
  capitalizedAmount Decimal          @map("capitalized_amount") @db.Decimal(19, 4)
  expensedAmount    Decimal          @map("expensed_amount") @db.Decimal(19, 4)
  reference         String?
  note              String?
  postedByUserId    String           @map("posted_by_user_id") @db.Uuid
  postedAt          DateTime         @default(now()) @map("posted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt      GoodsReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  document     InventoryDocument @relation("LandedCostDocument", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse         @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        LandedCostLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentId])
  @@index([organizationId, receiptId])
  @@map("landed_costs")
}

/// Share of a landed cost for one receipt line, with its effect on the valuation. Append-only.
model LandedCostLine {
  id                   String   @id @default(uuid(7)) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  landedCostId         String   @map("landed_cost_id") @db.Uuid
  receiptLineId        String   @map("receipt_line_id") @db.Uuid
  warehouseId          String   @map("warehouse_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  allocatedAmount      Decimal  @map("allocated_amount") @db.Decimal(19, 4)
  receivedQuantityBase Decimal  @map("received_quantity_base") @db.Decimal(20, 6)
  /// Quantity of the product on hand in the warehouse when the charge was posted.
  onHandQuantity       Decimal  @map("on_hand_quantity") @db.Decimal(20, 6)
  capitalizedAmount    Decimal  @map("capitalized_amount") @db.Decimal(19, 4)
  expensedAmount       Decimal  @map("expensed_amount") @db.Decimal(19, 4)
  previousValue        Decimal  @map("previous_value") @db.Decimal(19, 4)
  newValue             Decimal  @map("new_value") @db.Decimal(19, 4)
  previousUnitCost     Decimal? @map("previous_unit_cost") @db.Decimal(20, 6)
  newUnitCost          Decimal? @map("new_unit_cost") @db.Decimal(20, 6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  landedCost   LandedCost       @relation(fields: [organizationId, landedCostId], references: [organizationId, id], onDelete: Restrict)
  receiptLine  GoodsReceiptLine @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, landedCostId, receiptLineId])
  @@index([organizationId, warehouseId, productId])
  @@map("landed_cost_lines")
}

// ─── Purchase requisitions (Milestone 3c, ADR-029) ───

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_ORDERED
  ORDERED
  REJECTED
  CLOSED
  CANCELLED
}

/// A branch's request for goods; buyers turn its lines into purchase orders.
enum RfqStatus {
  DRAFT
  SENT
  AWARDED
  CANCELLED
}

/// Request for quotation (ADR-092): what to buy, for which warehouse, asked
/// of several suppliers. Their quotations are compared and lines awarded,
/// which creates draft purchase orders at the quoted prices.
model Rfq {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  number          String
  warehouseId     String    @map("warehouse_id") @db.Uuid
  title           String
  status          RfqStatus @default(DRAFT)
  neededBy        DateTime? @map("needed_by") @db.Date
  /// Quotations are asked for by this day.
  respondBy       DateTime? @map("respond_by") @db.Date
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  sentByUserId    String?   @map("sent_by_user_id") @db.Uuid
  /// Awarded or cancelled: who, when (and why, when cancelled).
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse     @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        RfqLine[]
  suppliers    RfqSupplier[]
  quotations   Quotation[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("rfqs")
}

model RfqLine {
  id                     String  @id @default(uuid(7)) @db.Uuid
  organizationId         String  @map("organization_id") @db.Uuid
  rfqId                  String  @map("rfq_id") @db.Uuid
  lineNo                 Int     @map("line_no")
  productId              String  @map("product_id") @db.Uuid
  uomId                  String  @map("uom_id") @db.Uuid
  quantity               Decimal @db.Decimal(20, 6)
  note                   String?
  /// The offer chosen at award; null = not awarded.
  awardedQuotationLineId String? @map("awarded_quotation_line_id") @db.Uuid
  /// Why, when the chosen offer was not the lowest comparable price.
  awardReason            String? @map("award_reason")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rfq            Rfq             @relation(fields: [organizationId, rfqId], references: [organizationId, id], onDelete: Cascade)
  product        Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom            UnitOfMeasure   @relation(fields: [uomId], references: [id], onDelete: Restrict)
  quotationLines QuotationLine[] @relation("QuotedLine")
  awardedLine    QuotationLine?  @relation("AwardedLine", fields: [organizationId, awardedQuotationLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, rfqId, lineNo])
  @@unique([organizationId, rfqId, productId])
  @@unique([organizationId, awardedQuotationLineId])
  @@map("rfq_lines")
}

/// A supplier asked to quote.
model RfqSupplier {
  organizationId String   @map("organization_id") @db.Uuid
  rfqId          String   @map("rfq_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rfq          Rfq          @relation(fields: [organizationId, rfqId], references: [organizationId, id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, rfqId, supplierId])
  @@map("rfq_suppliers")
}

/// One supplier's answer to an RFQ, as received (entered by a buyer).
model Quotation {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  rfqId           String    @map("rfq_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  currency        String    @db.Char(3)
  /// The supplier's own quotation number.
  reference       String?
  quotedOn        DateTime  @map("quoted_on") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  leadTimeDays    Int?      @map("lead_time_days")
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rfq            Rfq             @relation(fields: [organizationId, rfqId], references: [organizationId, id], onDelete: Restrict)
  supplier       Supplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines          QuotationLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, rfqId, supplierId])
  @@map("quotations")
}

model QuotationLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quotationId    String   @map("quotation_id") @db.Uuid
  rfqLineId      String   @map("rfq_line_id") @db.Uuid
  /// Per the RFQ line's unit, in the quotation's currency.
  unitPrice      Decimal  @map("unit_price") @db.Decimal(20, 6)
  /// What the supplier can supply, in the RFQ line's unit; null = all of it.
  quantity       Decimal? @db.Decimal(20, 6)
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotation    Quotation    @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  rfqLine      RfqLine      @relation("QuotedLine", fields: [organizationId, rfqLineId], references: [organizationId, id], onDelete: Restrict)
  awardedFor   RfqLine?     @relation("AwardedLine")

  @@unique([organizationId, id])
  @@unique([organizationId, quotationId, rfqLineId])
  @@map("quotation_lines")
}

model PurchaseRequisition {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  number            String
  warehouseId       String            @map("warehouse_id") @db.Uuid
  status            RequisitionStatus @default(DRAFT)
  neededBy          DateTime?         @map("needed_by") @db.Date
  note              String?
  createdByUserId   String            @map("created_by_user_id") @db.Uuid
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz(3)
  submittedByUserId String?           @map("submitted_by_user_id") @db.Uuid
  /// Rejected, closed or cancelled: who, when and why.
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(3)
  decidedByUserId   String?           @map("decided_by_user_id") @db.Uuid
  decisionReason    String?           @map("decision_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse                 @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        PurchaseRequisitionLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  requisitionId       String    @map("requisition_id") @db.Uuid
  lineNo              Int       @map("line_no")
  productId           String    @map("product_id") @db.Uuid
  uomId               String    @map("uom_id") @db.Uuid
  quantity            Decimal   @db.Decimal(20, 6)
  quantityBase        Decimal   @map("quantity_base") @db.Decimal(20, 6)
  note                String?
  /// The purchase order line this was ordered on; cleared if that line is removed or its order cancelled.
  purchaseOrderLineId String?   @map("purchase_order_line_id") @db.Uuid
  /// Or fulfilled from own stock by this shipment (central kitchen, ADR-046).
  shipmentId          String?   @map("shipment_id") @db.Uuid
  orderedAt           DateTime? @map("ordered_at") @db.Timestamptz(3)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requisition       PurchaseRequisition @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Cascade)
  product           Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom               UnitOfMeasure       @relation(fields: [uomId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine?  @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict)
  shipment          StockShipment?      @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, requisitionId, lineNo])
  @@unique([organizationId, requisitionId, productId])
  @@unique([organizationId, purchaseOrderLineId])
  @@map("purchase_requisition_lines")
}

// ─── Recipes and food cost (Milestone 4, ADR-030 / ADR-031) ───

enum RecipeType {
  /// Sold or served; costed per portion.
  DISH
  /// Batch preparation (sauce, dough, stock) used as a sub-recipe; costed per yield unit.
  PREPARATION
}

enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RecipeCostPolicy {
  AVERAGE
  LAST_PURCHASE
  STANDARD
}

enum RecipeSnapshotReason {
  ACTIVATION
  MANUAL
}

/// Stable identity of a recipe; its content lives in versions.
model Recipe {
  id                     String     @id @default(uuid(7)) @db.Uuid
  organizationId         String     @map("organization_id") @db.Uuid
  code                   String
  name                   String
  nameAr                 String?    @map("name_ar")
  type                   RecipeType
  description            String?
  archivedAt             DateTime?  @map("archived_at") @db.Timestamptz(3)
  /// Overrides the organization's target food cost for this recipe (fraction).
  targetFoodCostFraction Decimal?   @map("target_food_cost_fraction") @db.Decimal(7, 6)
  /// Sales tax code; null = the organization's default sales code.
  taxCodeId              String?    @map("tax_code_id") @db.Uuid
  /// Stock item a PREPARATION produces in the central kitchen (ADR-045).
  outputProductId        String?    @map("output_product_id") @db.Uuid
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions         RecipeVersion[]
  usedIn           RecipeIngredient[] @relation("SubRecipe")
  prices           RecipePrice[]
  labels           RecipeLabel[]
  outputProduct    Product?           @relation("RecipeOutput", fields: [organizationId, outputProductId], references: [organizationId, id], onDelete: Restrict)
  productionOrders ProductionOrder[]
  menuItems        MenuItem[]
  modifierOptions  ModifierOption[]
  taxCode          TaxCode?           @relation("RecipeTaxCode", fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)
  salesLines       SalesLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  /// Global search (ADR-088).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "recipes_name_trgm")
  @@map("recipes")
}

/// One version of a recipe. Only DRAFT versions can change (enforced by triggers).
model RecipeVersion {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  recipeId          String              @map("recipe_id") @db.Uuid
  versionNo         Int                 @map("version_no")
  status            RecipeVersionStatus @default(DRAFT)
  /// What one batch makes, e.g. 5 kg of sauce or 10 each (portions).
  yieldQuantity     Decimal             @map("yield_quantity") @db.Decimal(20, 6)
  yieldUomId        String              @map("yield_uom_id") @db.Uuid
  /// Portions one batch serves; required for dishes.
  portions          Decimal?            @db.Decimal(20, 6)
  note              String?
  /// Preparation method shown on the recipe card.
  method            String?
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  activatedAt       DateTime?           @map("activated_at") @db.Timestamptz(3)
  activatedByUserId String?             @map("activated_by_user_id") @db.Uuid
  retiredAt         DateTime?           @map("retired_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipe           Recipe               @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  yieldUom         UnitOfMeasure        @relation(fields: [yieldUomId], references: [id], onDelete: Restrict)
  ingredients      RecipeIngredient[]
  snapshots        RecipeCostSnapshot[]
  salesLines       SalesLine[]
  labels           RecipeLabel[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, recipeId, versionNo])
  @@index([organizationId, recipeId, status])
  @@map("recipe_versions")
}

/// An ingredient line: exactly one of product or sub-recipe (a PREPARATION).
model RecipeIngredient {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  versionId      String  @map("version_id") @db.Uuid
  lineNo         Int     @map("line_no")
  productId      String? @map("product_id") @db.Uuid
  subRecipeId    String? @map("sub_recipe_id") @db.Uuid
  /// Net quantity used, in uom_id.
  quantity       Decimal @db.Decimal(20, 6)
  uomId          String  @map("uom_id") @db.Uuid
  /// Trim/prep loss as a fraction (0.1 = 10 %); gross = net ÷ (1 − waste).
  wasteFraction  Decimal @default(0) @map("waste_fraction") @db.Decimal(7, 6)
  note           String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version      RecipeVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Cascade)
  product      Product?      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  subRecipe    Recipe?       @relation("SubRecipe", fields: [organizationId, subRecipeId], references: [organizationId, id], onDelete: Restrict)
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, versionId, lineNo])
  @@index([organizationId, productId])
  @@index([organizationId, subRecipeId])
  @@map("recipe_ingredients")
}

/// Manually set cost per base unit with the date it applies from. Append-only.
model ProductStandardCost {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  unitCost        Decimal  @map("unit_cost") @db.Decimal(20, 6)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  note            String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, effectiveFrom])
  @@map("product_standard_costs")
}

/// A stored cost calculation of a version, reproducible from its breakdown. Append-only.
model RecipeCostSnapshot {
  id                 String               @id @default(uuid(7)) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  versionId          String               @map("version_id") @db.Uuid
  reason             RecipeSnapshotReason
  policy             RecipeCostPolicy
  /// Average costs from this warehouse; null = organization-wide.
  warehouseId        String?              @map("warehouse_id") @db.Uuid
  /// Date standard costs were taken at.
  asOf               DateTime             @map("as_of") @db.Date
  totalCost          Decimal              @map("total_cost") @db.Decimal(19, 4)
  costPerPortion     Decimal?             @map("cost_per_portion") @db.Decimal(19, 4)
  costPerYieldUnit   Decimal              @map("cost_per_yield_unit") @db.Decimal(20, 6)
  /// Ingredients without any known cost; the totals exclude them.
  missingCount       Int                  @map("missing_count")
  /// Per-ingredient lines (decimal strings) with the cost source used.
  breakdown          Json
  calculatedByUserId String               @map("calculated_by_user_id") @db.Uuid
  calculatedAt       DateTime             @default(now()) @map("calculated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version      RecipeVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse?    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, versionId, calculatedAt(sort: Desc)])
  @@map("recipe_cost_snapshots")
}

/// Selling price of a dish (base currency, excluding VAT until M7) from a date. Append-only.
model RecipePrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  recipeId        String   @map("recipe_id") @db.Uuid
  price           Decimal  @db.Decimal(19, 4)
  /// The price was entered including VAT (the organization's setting at the time).
  includesTax     Boolean  @default(false) @map("includes_tax")
  effectiveFrom   DateTime @map("effective_from") @db.Date
  note            String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipe       Recipe       @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, recipeId, effectiveFrom])
  @@map("recipe_prices")
}

/// Organization-wide recipe settings (ADR-032).
model RecipeSettings {
  organizationId         String   @id @map("organization_id") @db.Uuid
  /// Target food cost as a fraction of the selling price; null = no target set.
  targetFoodCostFraction Decimal? @map("target_food_cost_fraction") @db.Decimal(7, 6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("recipe_settings")
}

// ─── Traceability and recalls (Milestone 6, ADR-033 / ADR-034) ───

enum RecallStatus {
  /// Scope being prepared; every view of it is a simulation.
  DRAFT
  /// Live: lots on recall hold, stock moved to ON_HOLD.
  ACTIVE
  CLOSED
}

enum RecallOutcome {
  /// Held stock written off.
  DISPOSED
  /// Recall hold lifted; stock stays ON_HOLD until released by hand.
  RELEASED
}

model Recall {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  number            String
  title             String
  reason            String
  status            RecallStatus   @default(DRAFT)
  outcome           RecallOutcome?
  createdByUserId   String         @map("created_by_user_id") @db.Uuid
  activatedAt       DateTime?      @map("activated_at") @db.Timestamptz(3)
  activatedByUserId String?        @map("activated_by_user_id") @db.Uuid
  closedAt          DateTime?      @map("closed_at") @db.Timestamptz(3)
  closedByUserId    String?        @map("closed_by_user_id") @db.Uuid
  closeNote         String?        @map("close_note")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lots         RecallLot[]
  stock        RecallStock[]
  documents    RecallDocument[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("recalls")
}

/// A lot in a recall's scope.
model RecallLot {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  recallId       String   @map("recall_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  addedAt        DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recall       Recall       @relation(fields: [organizationId, recallId], references: [organizationId, id], onDelete: Cascade)
  lot          InventoryLot @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, recallId, lotId])
  @@index([organizationId, lotId])
  @@map("recall_lots")
}

/// Stock of the recalled lots at activation, by place and status. Append-only.
model RecallStock {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  recallId       String      @map("recall_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  lotId          String      @map("lot_id") @db.Uuid
  warehouseId    String      @map("warehouse_id") @db.Uuid
  locationId     String?     @map("location_id") @db.Uuid
  stockStatus    StockStatus @map("stock_status")
  quantity       Decimal     @db.Decimal(20, 6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recall       Recall       @relation(fields: [organizationId, recallId], references: [organizationId, id], onDelete: Restrict)
  lot          InventoryLot @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, recallId])
  @@map("recall_stock")
}

enum RecallDocumentKind {
  HOLD
  DISPOSAL
}

/// Stock documents a recall posted (holds on activation, write-offs on disposal).
model RecallDocument {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  recallId       String             @map("recall_id") @db.Uuid
  documentId     String             @map("document_id") @db.Uuid
  kind           RecallDocumentKind

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recall       Recall            @relation(fields: [organizationId, recallId], references: [organizationId, id], onDelete: Restrict)
  document     InventoryDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, documentId])
  @@index([organizationId, recallId])
  @@map("recall_documents")
}

// ─── Food safety records, checklists, non-conformances (Milestone 6b, ADR-035) ───

enum CheckpointKind {
  FRIDGE
  FREEZER
  HOT_HOLDING
  COOKING
  AMBIENT
  OTHER
}

/// A monitored place or piece of equipment with temperature limits (°C).
model SafetyCheckpoint {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  code           String
  name           String
  kind           CheckpointKind
  minCelsius     Decimal?       @map("min_celsius") @db.Decimal(5, 1)
  maxCelsius     Decimal?       @map("max_celsius") @db.Decimal(5, 1)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch                        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  records       FoodSafetyRecord[]
  controlPoints HaccpControlPointCheckpoint[]
  equipment     Equipment[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, code])
  @@map("safety_checkpoints")
}

enum SafetyRecordType {
  TEMPERATURE
  HYGIENE
  CLEANING
  PEST_CONTROL
  OTHER
}

/// One food safety observation. Append-only; limits copied at the time of recording.
model FoodSafetyRecord {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  checkpointId     String?          @map("checkpoint_id") @db.Uuid
  type             SafetyRecordType
  /// Temperature readings only.
  valueCelsius     Decimal?         @map("value_celsius") @db.Decimal(5, 1)
  minCelsius       Decimal?         @map("min_celsius") @db.Decimal(5, 1)
  maxCelsius       Decimal?         @map("max_celsius") @db.Decimal(5, 1)
  /// Pass/fail checks (hygiene, cleaning, pest control, other).
  passed           Boolean?
  inSpec           Boolean          @map("in_spec")
  note             String?
  /// Required when out of spec: what was done immediately.
  correctiveNote   String?          @map("corrective_note")
  nonConformanceId String?          @map("non_conformance_id") @db.Uuid
  recordedAt       DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  checkpoint     SafetyCheckpoint? @relation(fields: [organizationId, checkpointId], references: [organizationId, id], onDelete: Restrict)
  nonConformance NonConformance?   @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, branchId, recordedAt(sort: Desc)])
  @@index([organizationId, checkpointId, recordedAt(sort: Desc)])
  @@map("food_safety_records")
}

enum ChecklistItemKind {
  YES_NO
  NUMBER
}

model ChecklistTemplate {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        ChecklistItem[]
  runs         ChecklistRun[]

  @@unique([organizationId, id])
  @@map("checklist_templates")
}

model ChecklistItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  templateId     String            @map("template_id") @db.Uuid
  position       Int
  text           String
  kind           ChecklistItemKind
  /// NUMBER items: acceptable range (either bound optional).
  minValue       Decimal?          @map("min_value") @db.Decimal(12, 3)
  maxValue       Decimal?          @map("max_value") @db.Decimal(12, 3)
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template     ChecklistTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, templateId, position])
  @@map("checklist_items")
}

/// A completed checklist. Append-only; answers keep the item text and limits as they were.
model ChecklistRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  failedCount       Int      @map("failed_count")
  note              String?
  nonConformanceId  String?  @map("non_conformance_id") @db.Uuid
  completedAt       DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  completedByUserId String   @map("completed_by_user_id") @db.Uuid

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template       ChecklistTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)
  branch         Branch            @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  nonConformance NonConformance?   @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)
  answers        ChecklistAnswer[]

  @@unique([organizationId, id])
  @@index([organizationId, branchId, completedAt(sort: Desc)])
  @@map("checklist_runs")
}

model ChecklistAnswer {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  runId          String            @map("run_id") @db.Uuid
  itemId         String            @map("item_id") @db.Uuid
  position       Int
  text           String
  kind           ChecklistItemKind
  minValue       Decimal?          @map("min_value") @db.Decimal(12, 3)
  maxValue       Decimal?          @map("max_value") @db.Decimal(12, 3)
  yes            Boolean?
  value          Decimal?          @db.Decimal(12, 3)
  ok             Boolean
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          ChecklistRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, runId, itemId])
  @@map("checklist_answers")
}

enum NcSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NcSource {
  MANUAL
  RECORD
  CHECKLIST
  AUDIT
  COMPLAINT
  EQUIPMENT
  MOCK_RECALL
}

enum NcStatus {
  OPEN
  INVESTIGATING
  ACTION_PLANNED
  CLOSED
}

model NonConformance {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  number         String
  branchId       String     @map("branch_id") @db.Uuid
  title          String
  description    String
  severity       NcSeverity
  source         NcSource
  status         NcStatus   @default(OPEN)
  rootCause      String?    @map("root_cause")
  raisedAt       DateTime   @default(now()) @map("raised_at") @db.Timestamptz(3)
  raisedByUserId String     @map("raised_by_user_id") @db.Uuid
  closedAt       DateTime?  @map("closed_at") @db.Timestamptz(3)
  closedByUserId String?    @map("closed_by_user_id") @db.Uuid
  closeNote      String?    @map("close_note")
  /// Raised by a reading out of a HACCP control point's limits (ADR-096).
  controlPointId String?    @map("control_point_id") @db.Uuid
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  controlPoint  HaccpControlPoint? @relation(fields: [organizationId, controlPointId], references: [organizationId, id], onDelete: Restrict)
  actions       CorrectiveAction[]
  records       FoodSafetyRecord[]
  runs          ChecklistRun[]
  auditFindings AuditFinding[]
  complaints    Complaint[]
  calibrations  Calibration[]
  mockRecalls   MockRecall[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("non_conformances")
}

enum CorrectiveActionStatus {
  OPEN
  DONE
  VERIFIED
}

model CorrectiveAction {
  id               String                 @id @default(uuid(7)) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  nonConformanceId String                 @map("non_conformance_id") @db.Uuid
  description      String
  ownerUserId      String?                @map("owner_user_id") @db.Uuid
  dueOn            DateTime?              @map("due_on") @db.Date
  status           CorrectiveActionStatus @default(OPEN)
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  doneAt           DateTime?              @map("done_at") @db.Timestamptz(3)
  doneByUserId     String?                @map("done_by_user_id") @db.Uuid
  doneNote         String?                @map("done_note")
  verifiedAt       DateTime?              @map("verified_at") @db.Timestamptz(3)
  verifiedByUserId String?                @map("verified_by_user_id") @db.Uuid
  verifyNote       String?                @map("verify_note")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  nonConformance NonConformance @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, nonConformanceId])
  @@map("corrective_actions")
}

// ─── HACCP plans (C2a, ADR-096) ───

enum HaccpPlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum HazardType {
  BIOLOGICAL
  CHEMICAL
  PHYSICAL
  ALLERGEN
}

/// CCP: critical control point; OPRP: operational prerequisite programme; PRP: prerequisite programme.
enum ControlClass {
  CCP
  OPRP
  PRP
}

/// A HACCP plan for a product or process (ADR-096). Edited as a draft,
/// approved by someone other than its author, then fixed; a change is a new
/// version of the same code, which supersedes the old one when approved.
model HaccpPlan {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  code             String
  version          Int             @default(1)
  name             String
  /// Null = the whole organization.
  branchId         String?         @map("branch_id") @db.Uuid
  /// Products or process covered, and their description.
  scope            String
  intendedUse      String?         @map("intended_use")
  team             String?
  status           HaccpPlanStatus @default(DRAFT)
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz(3)
  approvedByUserId String?         @map("approved_by_user_id") @db.Uuid
  reviewDueOn      DateTime?       @map("review_due_on") @db.Date
  supersededAt     DateTime?       @map("superseded_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch?             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  steps         HaccpStep[]
  hazards       HaccpHazard[]
  controlPoints HaccpControlPoint[]

  @@unique([organizationId, id])
  @@unique([organizationId, code, version])
  @@index([organizationId, status])
  @@map("haccp_plans")
}

model HaccpStep {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  planId         String  @map("plan_id") @db.Uuid
  position       Int
  name           String
  description    String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         HaccpPlan     @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  hazards      HaccpHazard[]

  @@unique([organizationId, id])
  @@unique([organizationId, planId, position])
  @@map("haccp_steps")
}

/// A hazard at a step, its assessment and how it is controlled.
model HaccpHazard {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  planId          String        @map("plan_id") @db.Uuid
  stepId          String        @map("step_id") @db.Uuid
  type            HazardType
  description     String
  /// 1–5 each, as assessed by the team; risk = likelihood × severity.
  likelihood      Int
  severity        Int
  significant     Boolean
  controlMeasures String?       @map("control_measures")
  /// Codex decision tree answers (Q1–Q4); null = not asked (the tree stopped earlier).
  q1              Boolean?
  q2              Boolean?
  q3              Boolean?
  q4              Boolean?
  /// What the tree concludes; null when the hazard is not significant.
  treeResult      ControlClass? @map("tree_result")
  classification  ControlClass
  /// Required when the classification differs from the tree's result.
  justification   String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         HaccpPlan          @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  step         HaccpStep          @relation(fields: [organizationId, stepId], references: [organizationId, id], onDelete: Cascade)
  controlPoint HaccpControlPoint?

  @@unique([organizationId, id])
  @@index([organizationId, planId])
  @@map("haccp_hazards")
}

/// Limits, monitoring, correction and verification for a CCP or OPRP.
model HaccpControlPoint {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  planId           String   @map("plan_id") @db.Uuid
  hazardId         String   @map("hazard_id") @db.Uuid
  criticalLimit    String   @map("critical_limit")
  /// Measurable limit, when there is one (temperature limits in °C).
  minValue         Decimal? @map("min_value") @db.Decimal(12, 3)
  maxValue         Decimal? @map("max_value") @db.Decimal(12, 3)
  unit             String?
  monitoring       String
  frequency        String
  responsible      String?
  correctiveAction String   @map("corrective_action")
  verification     String
  recordsKept      String?  @map("records_kept")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         HaccpPlan                     @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  hazard       HaccpHazard                   @relation(fields: [organizationId, hazardId], references: [organizationId, id], onDelete: Cascade)
  checkpoints  HaccpControlPointCheckpoint[]
  deviations   NonConformance[]

  @@unique([organizationId, id])
  @@unique([organizationId, hazardId])
  @@map("haccp_control_points")
}

/// A monitoring point whose readings are the evidence for a control point.
model HaccpControlPointCheckpoint {
  organizationId String @map("organization_id") @db.Uuid
  controlPointId String @map("control_point_id") @db.Uuid
  checkpointId   String @map("checkpoint_id") @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  controlPoint HaccpControlPoint @relation(fields: [organizationId, controlPointId], references: [organizationId, id], onDelete: Cascade)
  checkpoint   SafetyCheckpoint  @relation(fields: [organizationId, checkpointId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, controlPointId, checkpointId])
  @@index([organizationId, checkpointId])
  @@map("haccp_control_point_checkpoints")
}

// ─── Document control (C2b, ADR-097) ───

enum FsDocumentType {
  POLICY
  SOP
  WORK_INSTRUCTION
  FORM
  MANUAL
  OTHER
}

enum FsDocumentStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

/// A controlled food safety document (SOP, policy, work instruction, form, manual).
/// Its text lives in versions; only an approved version is in force.
model FsDocument {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  code              String
  title             String
  type              FsDocumentType
  /// Null = the whole organization.
  branchId          String?        @map("branch_id") @db.Uuid
  createdByUserId   String         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Withdrawn: no longer in use (kept for the record).
  withdrawnAt       DateTime?      @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnByUserId String?        @map("withdrawn_by_user_id") @db.Uuid
  withdrawReason    String?        @map("withdraw_reason")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  versions     FsDocumentVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("fs_documents")
}

model FsDocumentVersion {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  documentId       String           @map("document_id") @db.Uuid
  version          Int
  status           FsDocumentStatus @default(DRAFT)
  /// The document text; a file can be attached as well.
  content          String
  changeSummary    String?          @map("change_summary")
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(3)
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  effectiveFrom    DateTime?        @map("effective_from") @db.Date
  reviewDueOn      DateTime?        @map("review_due_on") @db.Date
  supersededAt     DateTime?        @map("superseded_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     FsDocument       @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  reads        FsDocumentRead[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentId, version])
  @@map("fs_document_versions")
}

/// Someone confirmed they read an approved version.
model FsDocumentRead {
  organizationId String   @map("organization_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version      FsDocumentVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, versionId, userId])
  @@map("fs_document_reads")
}

// ─── Audits and customer complaints (C2c, ADR-098) ───

enum AuditType {
  INTERNAL
  EXTERNAL
  AUTHORITY
  CUSTOMER
}

enum AuditStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  OBSERVATION
  MINOR
  MAJOR
  CRITICAL
}

/// An audit or inspection of a branch, planned and then carried out.
model Audit {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  number            String
  branchId          String      @map("branch_id") @db.Uuid
  type              AuditType
  /// Who audits: a person, a certification body, an authority.
  auditor           String
  scope             String
  plannedOn         DateTime    @map("planned_on") @db.Date
  status            AuditStatus @default(PLANNED)
  conductedOn       DateTime?   @map("conducted_on") @db.Date
  /// As reported by the auditor (e.g. a grade or a score); not computed here.
  result            String?
  summary           String?
  createdByUserId   String      @map("created_by_user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(3)
  completedByUserId String?     @map("completed_by_user_id") @db.Uuid
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?     @map("cancel_reason")
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  findings     AuditFinding[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, branchId, plannedOn])
  @@map("audits")
}

/// What an audit found. Anything above an observation opens a non-conformance.
model AuditFinding {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  auditId          String          @map("audit_id") @db.Uuid
  severity         FindingSeverity
  /// The requirement or clause concerned.
  reference        String?
  description      String
  nonConformanceId String?         @map("non_conformance_id") @db.Uuid
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit          Audit           @relation(fields: [organizationId, auditId], references: [organizationId, id], onDelete: Restrict)
  nonConformance NonConformance? @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, auditId])
  @@map("audit_findings")
}

enum ComplaintChannel {
  IN_PERSON
  PHONE
  EMAIL
  ONLINE
  DELIVERY_PLATFORM
  SOCIAL_MEDIA
  OTHER
}

enum ComplaintCategory {
  FOREIGN_OBJECT
  ILLNESS
  ALLERGEN
  QUALITY
  TEMPERATURE
  HYGIENE
  SERVICE
  OTHER
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

/// A customer complaint about a branch, its products or service.
model Complaint {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  number           String
  branchId         String            @map("branch_id") @db.Uuid
  receivedAt       DateTime          @map("received_at") @db.Timestamptz(3)
  channel          ComplaintChannel
  category         ComplaintCategory
  /// Only what is needed to reply; optional.
  customerName     String?           @map("customer_name")
  customerContact  String?           @map("customer_contact")
  /// The order or receipt the customer refers to, as given.
  orderReference   String?           @map("order_reference")
  productId        String?           @map("product_id") @db.Uuid
  lotId            String?           @map("lot_id") @db.Uuid
  description      String
  status           ComplaintStatus   @default(OPEN)
  investigation    String?
  resolution       String?
  /// What the customer was told or given.
  customerResponse String?           @map("customer_response")
  nonConformanceId String?           @map("non_conformance_id") @db.Uuid
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?         @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?           @map("resolved_by_user_id") @db.Uuid
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  product        Product?        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  nonConformance NonConformance? @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, branchId, receivedAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("complaints")
}

// ─── Equipment, calibration and maintenance (C2d, ADR-099) ───

enum EquipmentType {
  THERMOMETER
  FRIDGE
  FREEZER
  OVEN
  HOT_HOLDING
  SCALE
  DISHWASHER
  EXTRACTION
  OTHER
}

enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

/// A piece of equipment at a branch that needs calibration and/or maintenance.
model Equipment {
  id                      String          @id @default(uuid(7)) @db.Uuid
  organizationId          String          @map("organization_id") @db.Uuid
  branchId                String          @map("branch_id") @db.Uuid
  code                    String
  name                    String
  type                    EquipmentType
  serialNumber            String?         @map("serial_number")
  location                String?
  /// The temperature checkpoint this equipment is (or measures).
  checkpointId            String?         @map("checkpoint_id") @db.Uuid
  /// Set by the organization; null = not calibrated / no planned maintenance.
  calibrationIntervalDays Int?            @map("calibration_interval_days")
  maintenanceIntervalDays Int?            @map("maintenance_interval_days")
  status                  EquipmentStatus @default(ACTIVE)
  statusReason            String?         @map("status_reason")
  statusChangedAt         DateTime?       @map("status_changed_at") @db.Timestamptz(3)
  createdByUserId         String          @map("created_by_user_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  checkpoint   SafetyCheckpoint?   @relation(fields: [organizationId, checkpointId], references: [organizationId, id], onDelete: Restrict)
  calibrations Calibration[]
  maintenance  MaintenanceRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, code])
  @@map("equipment")
}

enum CalibrationResult {
  PASS
  FAIL
}

/// A calibration or check of a piece of equipment. Append-only.
model Calibration {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  equipmentId      String            @map("equipment_id") @db.Uuid
  performedOn      DateTime          @map("performed_on") @db.Date
  /// In-house or the calibration provider.
  performedBy      String            @map("performed_by")
  method           String?
  /// Reference value, reading and allowed deviation, when measured (e.g. ice point 0 °C, reads 0.4, ±1).
  referenceValue   Decimal?          @map("reference_value") @db.Decimal(12, 3)
  readingValue     Decimal?          @map("reading_value") @db.Decimal(12, 3)
  tolerance        Decimal?          @db.Decimal(12, 3)
  unit             String?
  result           CalibrationResult
  certificateNo    String?           @map("certificate_no")
  nextDueOn        DateTime?         @map("next_due_on") @db.Date
  note             String?
  nonConformanceId String?           @map("non_conformance_id") @db.Uuid
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment      Equipment       @relation(fields: [organizationId, equipmentId], references: [organizationId, id], onDelete: Restrict)
  nonConformance NonConformance? @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, equipmentId, performedOn(sort: Desc)])
  @@map("calibrations")
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  CLEANING
  INSPECTION
}

/// Maintenance carried out on a piece of equipment. Append-only.
model MaintenanceRecord {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  equipmentId      String          @map("equipment_id") @db.Uuid
  type             MaintenanceType
  performedOn      DateTime        @map("performed_on") @db.Date
  performedBy      String          @map("performed_by")
  description      String
  nextDueOn        DateTime?       @map("next_due_on") @db.Date
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment    @relation(fields: [organizationId, equipmentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, equipmentId, performedOn(sort: Desc)])
  @@map("maintenance_records")
}

// ─── Warehouse operations: receiving inspection and put-away (C3a, ADR-101) ───

enum InspectionDecision {
  ACCEPTED
  REJECTED
  PARTIAL
}

/// The quality check of one quarantined receipt line. Insert-only; its status change is in the ledger.
model ReceiptInspection {
  id                  String             @id @default(uuid(7)) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  receiptLineId       String             @map("receipt_line_id") @db.Uuid
  warehouseId         String             @map("warehouse_id") @db.Uuid
  productId           String             @map("product_id") @db.Uuid
  /// Base-unit quantities.
  acceptedQuantity    Decimal            @map("accepted_quantity") @db.Decimal(20, 6)
  rejectedQuantity    Decimal            @map("rejected_quantity") @db.Decimal(20, 6)
  decision            InspectionDecision
  temperatureCelsius  Decimal?           @map("temperature_celsius") @db.Decimal(5, 1)
  packagingOk         Boolean            @map("packaging_ok")
  labellingOk         Boolean            @map("labelling_ok")
  conditionOk         Boolean            @map("condition_ok")
  rejectionReason     String?            @map("rejection_reason")
  note                String?
  inventoryDocumentId String             @map("inventory_document_id") @db.Uuid
  inspectedByUserId   String             @map("inspected_by_user_id") @db.Uuid
  inspectedAt         DateTime           @default(now()) @map("inspected_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptLine  GoodsReceiptLine  @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse         @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  document     InventoryDocument @relation(fields: [organizationId, inventoryDocumentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, receiptLineId])
  @@index([organizationId, warehouseId, inspectedAt(sort: Desc)])
  @@map("receipt_inspections")
}

/// Where received stock should be put away. First matching active rule by priority wins.
model PutawayRule {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  warehouseId        String           @map("warehouse_id") @db.Uuid
  priority           Int
  /// Match conditions; all empty = any product.
  productId          String?          @map("product_id") @db.Uuid
  categoryId         String?          @map("category_id") @db.Uuid
  storageRequirement TemperatureZone? @map("storage_requirement")
  locationId         String           @map("location_id") @db.Uuid
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product      Product?         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  category     ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  location     StorageLocation  @relation(fields: [organizationId, warehouseId, locationId], references: [organizationId, warehouseId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, warehouseId, priority])
  @@map("putaway_rules")
}

// ─── Mock recall exercises (C2e, ADR-100) ───

enum MockRecallStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

/// A timed recall drill on one lot. Never touches stock: the book position is
/// copied at the start, the team counts what it finds, the clock stops at completion.
model MockRecall {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  number            String
  /// The site running the exercise; a failed exercise raises its non-conformance here.
  branchId          String           @map("branch_id") @db.Uuid
  productId         String           @map("product_id") @db.Uuid
  lotId             String           @map("lot_id") @db.Uuid
  scenario          String
  /// Target time set by the user; none means no target.
  targetMinutes     Int?             @map("target_minutes")
  status            MockRecallStatus @default(RUNNING)
  startedAt         DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  startedByUserId   String           @map("started_by_user_id") @db.Uuid
  /// Book position of the lot at the start.
  receivedQuantity  Decimal          @map("received_quantity") @db.Decimal(20, 6)
  exitedQuantity    Decimal          @map("exited_quantity") @db.Decimal(20, 6)
  onHandQuantity    Decimal          @map("on_hand_quantity") @db.Decimal(20, 6)
  gapCount          Int              @map("gap_count")
  supplierCount     Int              @map("supplier_count")
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(3)
  completedByUserId String?          @map("completed_by_user_id") @db.Uuid
  elapsedSeconds    Int?             @map("elapsed_seconds")
  foundQuantity     Decimal?         @map("found_quantity") @db.Decimal(20, 6)
  /// (left the business + found) / received, in percent.
  accountedPercent  Decimal?         @map("accounted_percent") @db.Decimal(7, 2)
  withinTarget      Boolean?         @map("within_target")
  findings          String?
  nonConformanceId  String?          @map("non_conformance_id") @db.Uuid
  cancelNote        String?          @map("cancel_note")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch            @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  lot            InventoryLot      @relation(fields: [organizationId, productId, lotId], references: [organizationId, productId, id], onDelete: Restrict)
  nonConformance NonConformance?   @relation(fields: [organizationId, nonConformanceId], references: [organizationId, id], onDelete: Restrict)
  counts         MockRecallCount[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, startedAt(sort: Desc)])
  @@map("mock_recalls")
}

/// Book stock of the lot at one place when the exercise started, and what the team found there.
model MockRecallCount {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  mockRecallId   String      @map("mock_recall_id") @db.Uuid
  warehouseId    String      @map("warehouse_id") @db.Uuid
  locationId     String?     @map("location_id") @db.Uuid
  stockStatus    StockStatus @map("stock_status")
  bookQuantity   Decimal     @map("book_quantity") @db.Decimal(20, 6)
  foundQuantity  Decimal?    @map("found_quantity") @db.Decimal(20, 6)
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mockRecall   MockRecall   @relation(fields: [organizationId, mockRecallId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, mockRecallId])
  @@map("mock_recall_counts")
}

// ─── Sales import and recipe consumption (Milestone 7a, ADR-036) ───

enum SalesImportStatus {
  POSTED
  REVERSED
}

enum SalesItemType {
  RECIPE
  PRODUCT
}

/// One uploaded sales file for one warehouse; its stock use is one CONSUMPTION document.
model SalesImport {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  number             String
  warehouseId        String            @map("warehouse_id") @db.Uuid
  fileName           String?           @map("file_name")
  status             SalesImportStatus @default(POSTED)
  lineCount          Int               @map("line_count")
  /// Rows already imported earlier (same external id), not posted again.
  skippedCount       Int               @map("skipped_count")
  /// Sum of the file's net amounts (as given, excluding VAT); null when the file had none.
  netAmount          Decimal?          @map("net_amount") @db.Decimal(19, 4)
  taxAmount          Decimal?          @map("tax_amount") @db.Decimal(19, 4)
  grossAmount        Decimal?          @map("gross_amount") @db.Decimal(19, 4)
  /// Stock value consumed (moving average at posting).
  costAmount         Decimal           @map("cost_amount") @db.Decimal(19, 4)
  documentId         String            @map("document_id") @db.Uuid
  reversalDocumentId String?           @map("reversal_document_id") @db.Uuid
  postedByUserId     String            @map("posted_by_user_id") @db.Uuid
  postedAt           DateTime          @default(now()) @map("posted_at") @db.Timestamptz(3)
  reversedAt         DateTime?         @map("reversed_at") @db.Timestamptz(3)
  reversedByUserId   String?           @map("reversed_by_user_id") @db.Uuid
  reversalReason     String?           @map("reversal_reason")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse    Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  document     InventoryDocument  @relation("SalesConsumption", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  reversal     InventoryDocument? @relation("SalesReversal", fields: [organizationId, reversalDocumentId], references: [organizationId, id], onDelete: Restrict)
  lines        SalesLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, documentId])
  @@unique([organizationId, reversalDocumentId])
  @@index([organizationId, postedAt(sort: Desc)])
  @@map("sales_imports")
}

/// A sold item from an import. The external id is unique among active lines (idempotent imports).
model SalesLine {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  importId        String        @map("import_id") @db.Uuid
  rowNo           Int           @map("row_no")
  externalId      String        @map("external_id")
  soldOn          DateTime      @map("sold_on") @db.Date
  channel         String?
  itemType        SalesItemType @map("item_type")
  recipeId        String?       @map("recipe_id") @db.Uuid
  /// The recipe version that was active when the line was posted.
  recipeVersionId String?       @map("recipe_version_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  quantity        Decimal       @db.Decimal(20, 6)
  netAmount       Decimal?      @map("net_amount") @db.Decimal(19, 4)
  /// VAT applied (ADR-037): code and rate at the sale date, tax and gross amounts.
  taxCodeId       String?       @map("tax_code_id") @db.Uuid
  taxRate         Decimal?      @map("tax_rate") @db.Decimal(7, 6)
  taxAmount       Decimal?      @map("tax_amount") @db.Decimal(19, 4)
  grossAmount     Decimal?      @map("gross_amount") @db.Decimal(19, 4)
  /// False once the import is reversed; the external id may then be imported again.
  active          Boolean       @default(true)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesImport   SalesImport    @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  recipe        Recipe?        @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  recipeVersion RecipeVersion? @relation(fields: [organizationId, recipeVersionId], references: [organizationId, id], onDelete: Restrict)
  product       Product?       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  taxCode       TaxCode?       @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, importId])
  @@index([organizationId, soldOn])
  @@map("sales_lines")
}

// ─── VAT setup (ADR-037) ───

enum TaxCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

/// A VAT code of the organization (e.g. VAT15, ZERO, EXEMPT); rates change by date.
model TaxCode {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String
  name           String
  nameAr         String?     @map("name_ar")
  category       TaxCategory
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rates              TaxRate[]
  recipes            Recipe[]              @relation("RecipeTaxCode")
  purchaseProducts   Product[]             @relation("ProductPurchaseTaxCode")
  salesLines         SalesLine[]
  salesDefaultFor    TaxSettings[]         @relation("DefaultSalesTax")
  invoiceLines       SupplierInvoiceLine[]
  purchaseDefaultFor TaxSettings[]         @relation("DefaultPurchaseTax")
  settlements        SupplierSettlement[]
  salesOrderLines    SalesOrderLine[]
  salesInvoiceLines  SalesInvoiceLine[]

  menuItems MenuItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("tax_codes")
}

/// Rate of a tax code from a date (fraction: 0.15 = 15 %). Append-only.
model TaxRate {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  taxCodeId       String   @map("tax_code_id") @db.Uuid
  rate            Decimal  @db.Decimal(7, 6)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  /// The country whose rate this is (ADR-084); a code's rates differ by country.
  country         String?  @db.Char(2)
  /// Where the rate comes from (law, preset source).
  source          String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taxCode      TaxCode      @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, taxCodeId, country, effectiveFrom])
  @@map("tax_rates")
}

model TaxSettings {
  organizationId           String    @id @map("organization_id") @db.Uuid
  /// ISO country whose VAT rules apply (SA, AE, BH, OM, QA, KW, EG).
  country                  String?   @db.Char(2)
  vatRegistered            Boolean   @default(false) @map("vat_registered")
  vatNumber                String?   @map("vat_number")
  /// Selling prices (recipes, imported sales) are entered including VAT.
  pricesIncludeTax         Boolean   @default(false) @map("prices_include_tax")
  defaultSalesTaxCodeId    String?   @map("default_sales_tax_code_id") @db.Uuid
  defaultPurchaseTaxCodeId String?   @map("default_purchase_tax_code_id") @db.Uuid
  presetAppliedAt          DateTime? @map("preset_applied_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultSalesTaxCode    TaxCode?     @relation("DefaultSalesTax", fields: [organizationId, defaultSalesTaxCodeId], references: [organizationId, id], onDelete: Restrict)
  defaultPurchaseTaxCode TaxCode?     @relation("DefaultPurchaseTax", fields: [organizationId, defaultPurchaseTaxCodeId], references: [organizationId, id], onDelete: Restrict)

  @@map("tax_settings")
}

// ─── Supplier invoices and 3-way match (Milestone 7b, ADR-038) ───

enum SupplierInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InvoiceMatchStatus {
  MATCHED
  EXCEPTION
}

enum InvoiceLineKind {
  GOODS
  CHARGE
}

enum InvoiceLineMatch {
  MATCHED
  PRICE_VARIANCE
  QUANTITY_VARIANCE
  PRICE_AND_QUANTITY
  /// Charge lines (no order or receipt to match).
  NOT_APPLICABLE
}

model SupplierInvoice {
  id                    String                @id @default(uuid(7)) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId             String?               @map("company_id") @db.Uuid
  number                String
  supplierId            String                @map("supplier_id") @db.Uuid
  /// The supplier's own invoice number.
  supplierInvoiceNo     String                @map("supplier_invoice_no")
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  dueDate               DateTime?             @map("due_date") @db.Date
  status                SupplierInvoiceStatus @default(DRAFT)
  /// Total incl. VAT as printed on the supplier's document, checked against the lines.
  printedGross          Decimal               @map("printed_gross") @db.Decimal(19, 4)
  netAmount             Decimal               @default(0) @map("net_amount") @db.Decimal(19, 4)
  taxAmount             Decimal               @default(0) @map("tax_amount") @db.Decimal(19, 4)
  grossAmount           Decimal               @default(0) @map("gross_amount") @db.Decimal(19, 4)
  /// Document currency, the rate on the invoice date and base-currency totals (ADR-050).
  currency              String                @db.Char(3)
  exchangeRate          Decimal               @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate              DateTime?             @map("rate_date") @db.Date
  netAmountBase         Decimal               @default(0) @map("net_amount_base") @db.Decimal(19, 4)
  taxAmountBase         Decimal               @default(0) @map("tax_amount_base") @db.Decimal(19, 4)
  grossAmountBase       Decimal               @default(0) @map("gross_amount_base") @db.Decimal(19, 4)
  matchStatus           InvoiceMatchStatus    @default(MATCHED) @map("match_status")
  note                  String?
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  exceptionApprovedAt   DateTime?             @map("exception_approved_at") @db.Timestamptz(3)
  exceptionApprovedById String?               @map("exception_approved_by_id") @db.Uuid
  exceptionNote         String?               @map("exception_note")
  postedAt              DateTime?             @map("posted_at") @db.Timestamptz(3)
  postedByUserId        String?               @map("posted_by_user_id") @db.Uuid
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId     String?               @map("cancelled_by_user_id") @db.Uuid
  cancelReason          String?               @map("cancel_reason")
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier               @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines        SupplierInvoiceLine[]
  allocations  SettlementAllocation[]

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, supplierId, invoiceDate])
  @@index([organizationId, status])
  @@index([organizationId, companyId], map: "supplier_invoices_company_idx")
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "supplier_invoices_number_trgm")
  @@index([supplierInvoiceNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "supplier_invoices_ref_trgm")
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id                  String           @id @default(uuid(7)) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  invoiceId           String           @map("invoice_id") @db.Uuid
  lineNo              Int              @map("line_no")
  kind                InvoiceLineKind
  receiptLineId       String?          @map("receipt_line_id") @db.Uuid
  purchaseOrderLineId String?          @map("purchase_order_line_id") @db.Uuid
  productId           String?          @map("product_id") @db.Uuid
  description         String
  /// Goods: in the order line's unit.
  uomId               String?          @map("uom_id") @db.Uuid
  quantity            Decimal          @db.Decimal(20, 6)
  quantityBase        Decimal?         @map("quantity_base") @db.Decimal(20, 6)
  unitPrice           Decimal          @map("unit_price") @db.Decimal(20, 6)
  /// Prices to match against (per uom_id): the order and the receipt.
  orderedUnitPrice    Decimal?         @map("ordered_unit_price") @db.Decimal(20, 6)
  receivedUnitPrice   Decimal?         @map("received_unit_price") @db.Decimal(20, 6)
  taxCodeId           String?          @map("tax_code_id") @db.Uuid
  taxRate             Decimal?         @map("tax_rate") @db.Decimal(7, 6)
  netAmount           Decimal          @map("net_amount") @db.Decimal(19, 4)
  taxAmount           Decimal          @map("tax_amount") @db.Decimal(19, 4)
  grossAmount         Decimal          @map("gross_amount") @db.Decimal(19, 4)
  match               InvoiceLineMatch @default(NOT_APPLICABLE)
  /// Invoiced quantity beyond what was received and not yet invoiced (base unit).
  quantityVariance    Decimal?         @map("quantity_variance") @db.Decimal(20, 6)
  /// (Invoice − order unit price) × quantity.
  priceVariance       Decimal?         @map("price_variance") @db.Decimal(19, 4)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice           SupplierInvoice    @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  receiptLine       GoodsReceiptLine?  @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict)
  product           Product?           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom               UnitOfMeasure?     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  taxCode           TaxCode?           @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceId, lineNo])
  @@index([organizationId, receiptLineId])
  @@map("supplier_invoice_lines")
}

// ─── Payables (Milestone 7c, ADR-039) ───

enum SettlementKind {
  PAYMENT
  CREDIT_NOTE
}

enum SettlementStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

/// A payment to a supplier or a credit note from one; reduces the supplier balance.
model SupplierSettlement {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  number             String
  kind               SettlementKind
  supplierId         String           @map("supplier_id") @db.Uuid
  /// The paying company (ADR-086): settles only its own invoices; base amounts are in its currency. Set by the database when omitted.
  companyId          String?          @map("company_id") @db.Uuid
  date               DateTime         @db.Date
  /// Total incl. VAT.
  amount             Decimal          @db.Decimal(19, 4)
  /// Document currency, rate on the settlement date, base amounts (ADR-050).
  currency           String           @db.Char(3)
  exchangeRate       Decimal          @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate           DateTime?        @map("rate_date") @db.Date
  amountBase         Decimal          @default(0) @map("amount_base") @db.Decimal(19, 4)
  taxAmountBase      Decimal          @default(0) @map("tax_amount_base") @db.Decimal(19, 4)
  /// Credit notes only: net and VAT.
  netAmount          Decimal?         @map("net_amount") @db.Decimal(19, 4)
  taxAmount          Decimal          @default(0) @map("tax_amount") @db.Decimal(19, 4)
  taxCodeId          String?          @map("tax_code_id") @db.Uuid
  taxRate            Decimal?         @map("tax_rate") @db.Decimal(9, 6)
  /// Payments only.
  method             PaymentMethod?
  reference          String?
  /// Credit notes only: the supplier's own document number.
  supplierDocumentNo String?          @map("supplier_document_no")
  note               String?
  status             SettlementStatus @default(POSTED)
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt           DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedByUserId     String?          @map("voided_by_user_id") @db.Uuid
  voidReason         String?          @map("void_reason")

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier        Supplier               @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  company         Company?               @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  taxCode         TaxCode?               @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)
  allocations     SettlementAllocation[]
  creditedReturns SupplierReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, supplierId, date])
  @@index([organizationId, companyId, supplierId], map: "supplier_settlements_company_idx")
  @@map("supplier_settlements")
}

/// Part of a settlement applied to a posted invoice.
model SettlementAllocation {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  settlementId     String   @map("settlement_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  amount           Decimal  @db.Decimal(19, 4)
  /// Realised exchange difference, base currency: amount × (settlement rate − invoice rate); + = loss.
  fxDifferenceBase Decimal  @default(0) @map("fx_difference_base") @db.Decimal(19, 4)
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlement   SupplierSettlement @relation(fields: [organizationId, settlementId], references: [organizationId, id], onDelete: Restrict)
  invoice      SupplierInvoice    @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, settlementId])
  @@map("settlement_allocations")
}

/// The organization's own account codes for the journal export; never invented.
model AccountingSettings {
  organizationId      String   @id @map("organization_id") @db.Uuid
  payablesAccount     String?  @map("payables_account")
  purchasesAccount    String?  @map("purchases_account")
  inputVatAccount     String?  @map("input_vat_account")
  paymentsAccount     String?  @map("payments_account")
  /// Realised exchange gains and losses (ADR-050).
  fxDifferenceAccount String?  @map("fx_difference_account")
  /// B2B (ADR-056): customer receivables, sales, output VAT, bank for customer receipts.
  receivablesAccount  String?  @map("receivables_account")
  salesAccount        String?  @map("sales_account")
  outputVatAccount    String?  @map("output_vat_account")
  receiptsAccount     String?  @map("receipts_account")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("accounting_settings")
}

// ─── Nutrition and allergens (Milestone 5a, ADR-040) ───

enum AllergenStatus {
  CONTAINS
  MAY_CONTAIN
  FREE_FROM
  UNKNOWN
}

enum NutritionSource {
  SUPPLIER_SPEC
  LAB
  DATABASE
  MANUAL
}

enum NutritionBasis {
  PER_100G
  PER_100ML
}

enum LabelStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// What is known about one allergen in one product. Append-only: a new
/// declaration supersedes the current one. No current row = UNKNOWN.
model AllergenDeclaration {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  /// Code from src/modules/nutrition/allergens.ts (CK in SQL).
  allergen         String
  status           AllergenStatus
  source           NutritionSource
  /// Specification, lab report or database record the statement comes from.
  reference        String?
  note             String?
  declaredByUserId String          @map("declared_by_user_id") @db.Uuid
  declaredAt       DateTime        @default(now()) @map("declared_at") @db.Timestamptz(3)
  verifiedByUserId String?         @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?       @map("verified_at") @db.Timestamptz(3)
  supersededAt     DateTime?       @map("superseded_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, productId, allergen])
  @@map("allergen_declarations")
}

/// Nutrition values per 100 g or 100 ml; NULL = not known. Append-only like declarations.
model NutritionProfile {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  basis            NutritionBasis
  energyKcal       Decimal?        @map("energy_kcal") @db.Decimal(12, 4)
  energyKj         Decimal?        @map("energy_kj") @db.Decimal(12, 4)
  fat              Decimal?        @db.Decimal(12, 4)
  saturatedFat     Decimal?        @map("saturated_fat") @db.Decimal(12, 4)
  carbohydrate     Decimal?        @db.Decimal(12, 4)
  sugars           Decimal?        @db.Decimal(12, 4)
  fibre            Decimal?        @db.Decimal(12, 4)
  protein          Decimal?        @db.Decimal(12, 4)
  salt             Decimal?        @db.Decimal(12, 4)
  sodium           Decimal?        @db.Decimal(12, 4)
  source           NutritionSource
  reference        String?
  note             String?
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedByUserId String?         @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?       @map("verified_at") @db.Timestamptz(3)
  supersededAt     DateTime?       @map("superseded_at") @db.Timestamptz(3)
  /// Library record the values were copied from (source DATABASE).
  referenceFoodId  String?         @map("reference_food_id") @db.Uuid

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  referenceFood ReferenceFood? @relation(fields: [organizationId, referenceFoodId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, productId])
  @@map("nutrition_profiles")
}

/// A calculated label for a recipe version, reviewed by a second person.
model RecipeLabel {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  recipeId         String      @map("recipe_id") @db.Uuid
  versionId        String      @map("version_id") @db.Uuid
  labelNo          Int         @map("label_no")
  status           LabelStatus @default(PENDING_REVIEW)
  /// The calculated label (nutrition, allergens, ingredient list) as shown for review.
  content          Json
  /// Hash of the inputs; a different current hash means the data changed since.
  inputsHash       String      @map("inputs_hash")
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedByUserId String?     @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?     @map("review_note")
  supersededAt     DateTime?   @map("superseded_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipe       Recipe        @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  version      RecipeVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, recipeId, labelNo])
  @@index([organizationId, recipeId, status])
  @@map("recipe_labels")
}

// ─── Ingredient library (Milestone 5b, ADR-041) ───

enum ReferenceSource {
  USDA_FDC
  OPEN_FOOD_FACTS
  WIKIDATA
}

/// A record copied from a public food database, with its licence and
/// provenance. Reference only: a product uses it after a person links it,
/// and the copied values stay unverified until a second person checks them.
model ReferenceFood {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  source          ReferenceSource
  /// FDC id, Open Food Facts barcode or Wikidata QID.
  sourceId        String          @map("source_id")
  /// e.g. "Foundation", "SR Legacy", "Branded".
  dataType        String?         @map("data_type")
  name            String
  nameAr          String?         @map("name_ar")
  description     String?
  brand           String?
  basis           NutritionBasis?
  energyKcal      Decimal?        @map("energy_kcal") @db.Decimal(12, 4)
  energyKj        Decimal?        @map("energy_kj") @db.Decimal(12, 4)
  fat             Decimal?        @db.Decimal(12, 4)
  saturatedFat    Decimal?        @map("saturated_fat") @db.Decimal(12, 4)
  carbohydrate    Decimal?        @db.Decimal(12, 4)
  sugars          Decimal?        @db.Decimal(12, 4)
  fibre           Decimal?        @db.Decimal(12, 4)
  protein         Decimal?        @db.Decimal(12, 4)
  salt            Decimal?        @db.Decimal(12, 4)
  sodium          Decimal?        @db.Decimal(12, 4)
  /// Allergen codes the source lists as present / as traces (Open Food Facts).
  allergens       String[]        @default([])
  traces          String[]        @default([])
  /// Source tags not mapped to the 14 allergens, kept for review.
  unmappedTags    String[]        @default([]) @map("unmapped_tags")
  /// How a value was chosen when the source has several (e.g. which energy figure).
  notes           String[]        @default([])
  licence         String
  attribution     String
  sourceUrl       String          @map("source_url")
  /// Product this record was linked to, if any.
  linkedProductId String?         @map("linked_product_id") @db.Uuid
  importId        String          @map("import_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  import        ReferenceImport    @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  linkedProduct Product?           @relation("ReferenceLinkedProduct", fields: [organizationId, linkedProductId], references: [organizationId, id], onDelete: Restrict)
  profiles      NutritionProfile[]

  @@unique([organizationId, id])
  @@unique([organizationId, source, sourceId])
  @@index([organizationId, name])
  @@map("reference_foods")
}

/// One uploaded library file; the same file (by hash) is imported once.
model ReferenceImport {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  source           ReferenceSource
  fileName         String          @map("file_name")
  sha256           String
  created          Int             @default(0)
  updated          Int             @default(0)
  skipped          Int             @default(0)
  /// Records that could not be read, with the reason.
  problems         Json            @default("[]")
  importedByUserId String          @map("imported_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  foods        ReferenceFood[]

  @@unique([organizationId, id])
  @@unique([organizationId, sha256])
  @@map("reference_imports")
}

// ─── Central kitchen production (Milestone 9a, ADR-045) ───

enum ProductionStatus {
  PLANNED
  COMPLETED
  REVERSED
  CANCELLED
}

/// A batch of a PREPARATION recipe made in one warehouse: ingredients are
/// consumed FEFO and the output product enters stock as a lot at their value.
model ProductionOrder {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  number               String
  recipeId             String           @map("recipe_id") @db.Uuid
  versionId            String           @map("version_id") @db.Uuid
  warehouseId          String           @map("warehouse_id") @db.Uuid
  outputProductId      String           @map("output_product_id") @db.Uuid
  /// Planned quantity in the recipe's yield unit; ingredients are consumed for this.
  plannedQuantity      Decimal          @map("planned_quantity") @db.Decimal(20, 6)
  plannedUomId         String           @map("planned_uom_id") @db.Uuid
  plannedFor           DateTime?        @map("planned_for") @db.Date
  status               ProductionStatus @default(PLANNED)
  /// Actual output, in the output product's base unit.
  producedQuantityBase Decimal?         @map("produced_quantity_base") @db.Decimal(20, 6)
  outputLotId          String?          @map("output_lot_id") @db.Uuid
  /// Stock value consumed = value of the output.
  cost                 Decimal?         @db.Decimal(19, 4)
  documentId           String?          @map("document_id") @db.Uuid
  reversalDocumentId   String?          @map("reversal_document_id") @db.Uuid
  note                 String?
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz(3)
  completedByUserId    String?          @map("completed_by_user_id") @db.Uuid
  closedAt             DateTime?        @map("closed_at") @db.Timestamptz(3)
  closedByUserId       String?          @map("closed_by_user_id") @db.Uuid
  closeReason          String?          @map("close_reason")
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipe        Recipe             @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  version       RecipeVersion      @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  outputProduct Product            @relation(fields: [organizationId, outputProductId], references: [organizationId, id], onDelete: Restrict)
  plannedUom    UnitOfMeasure      @relation(fields: [plannedUomId], references: [id], onDelete: Restrict)
  outputLot     InventoryLot?      @relation(fields: [organizationId, outputProductId, outputLotId], references: [organizationId, productId, id], onDelete: Restrict)
  document      InventoryDocument? @relation("ProductionDocument", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  reversal      InventoryDocument? @relation("ProductionReversal", fields: [organizationId, reversalDocumentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, documentId])
  @@unique([organizationId, reversalDocumentId])
  @@index([organizationId, warehouseId, status])
  @@map("production_orders")
}

// ─── B2B customers and sales (Milestone 9b, ADR-047) ───

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  POSTED
  REVERSED
}

enum SalesInvoiceStatus {
  POSTED
  CANCELLED
}

model Customer {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  code             String
  name             String
  nameAr           String?   @map("name_ar")
  taxId            String?   @map("tax_id")
  email            String?
  phone            String?
  address          String?
  /// Buyer details on standard e-invoices in Saudi Arabia (ADR-072); `taxId` is the VAT number.
  crNumber         String?   @map("cr_number")
  street           String?
  buildingNumber   String?   @map("building_number")
  district         String?
  city             String?
  postalCode       String?   @map("postal_code")
  countryCode      String    @default("SA") @map("country_code") @db.Char(2)
  paymentTermsDays Int?      @map("payment_terms_days")
  /// Default currency of this customer's orders, invoices and receipts (ADR-054); null = base.
  currency         String?   @db.Char(3)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders             SalesOrder[]
  invoices           SalesInvoice[]
  receipts           CustomerReceipt[]
  fxRevaluationLines FxRevaluationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  /// Global search (ADR-088).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm")
  @@map("customers")
}

model SalesOrder {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId         String?          @map("company_id") @db.Uuid
  number            String
  customerId        String           @map("customer_id") @db.Uuid
  warehouseId       String           @map("warehouse_id") @db.Uuid
  /// Prices are in this currency (default: the customer's; ADR-054).
  currency          String           @db.Char(3)
  status            SalesOrderStatus @default(DRAFT)
  customerRef       String?          @map("customer_ref")
  requestedOn       DateTime?        @map("requested_on") @db.Date
  note              String?
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt       DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  confirmedByUserId String?          @map("confirmed_by_user_id") @db.Uuid
  cancelledAt       DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?          @map("cancel_reason")
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse          @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        SalesOrderLine[]
  deliveries   CustomerDelivery[]

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, customerId, status])
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_orders_number_trgm")
  @@map("sales_orders")
}

model SalesOrderLine {
  id                    String  @id @default(uuid(7)) @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  orderId               String  @map("order_id") @db.Uuid
  lineNo                Int     @map("line_no")
  productId             String  @map("product_id") @db.Uuid
  uomId                 String  @map("uom_id") @db.Uuid
  quantity              Decimal @db.Decimal(20, 6)
  quantityBase          Decimal @map("quantity_base") @db.Decimal(20, 6)
  /// Net price per `uomId`.
  unitPrice             Decimal @map("unit_price") @db.Decimal(20, 6)
  /// Null = the organization's default sales VAT code.
  taxCodeId             String? @map("tax_code_id") @db.Uuid
  deliveredQuantityBase Decimal @default(0) @map("delivered_quantity_base") @db.Decimal(20, 6)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order         SalesOrder             @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  product       Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  uom           UnitOfMeasure          @relation(fields: [uomId], references: [id], onDelete: Restrict)
  taxCode       TaxCode?               @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)
  deliveryLines CustomerDeliveryLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNo])
  @@map("sales_order_lines")
}

/// Goods sent to a customer: one CUSTOMER_DELIVERY stock document.
model CustomerDelivery {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  number             String
  orderId            String         @map("order_id") @db.Uuid
  status             DeliveryStatus @default(POSTED)
  documentId         String         @map("document_id") @db.Uuid
  reversalDocumentId String?        @map("reversal_document_id") @db.Uuid
  /// Stock value of what was delivered (cost of goods sold).
  cost               Decimal        @db.Decimal(19, 4)
  deliveredAt        DateTime       @default(now()) @map("delivered_at") @db.Timestamptz(3)
  deliveredByUserId  String         @map("delivered_by_user_id") @db.Uuid
  reversedAt         DateTime?      @map("reversed_at") @db.Timestamptz(3)
  reversalReason     String?        @map("reversal_reason")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        SalesOrder             @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  document     InventoryDocument      @relation("DeliveryDocument", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  reversal     InventoryDocument?     @relation("DeliveryReversal", fields: [organizationId, reversalDocumentId], references: [organizationId, id], onDelete: Restrict)
  lines        CustomerDeliveryLine[]
  invoices     SalesInvoice[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, documentId])
  @@unique([organizationId, reversalDocumentId])
  @@map("customer_deliveries")
}

model CustomerDeliveryLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  deliveryId     String  @map("delivery_id") @db.Uuid
  orderLineId    String  @map("order_line_id") @db.Uuid
  quantityBase   Decimal @map("quantity_base") @db.Decimal(20, 6)
  cost           Decimal @db.Decimal(19, 4)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  delivery     CustomerDelivery @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict)
  orderLine    SalesOrderLine   @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, deliveryId, orderLineId])
  @@map("customer_delivery_lines")
}

model SalesInvoice {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId         String?            @map("company_id") @db.Uuid
  number            String
  customerId        String             @map("customer_id") @db.Uuid
  deliveryId        String             @map("delivery_id") @db.Uuid
  invoiceDate       DateTime           @map("invoice_date") @db.Date
  dueDate           DateTime?          @map("due_date") @db.Date
  status            SalesInvoiceStatus @default(POSTED)
  netAmount         Decimal            @map("net_amount") @db.Decimal(19, 4)
  taxAmount         Decimal            @map("tax_amount") @db.Decimal(19, 4)
  grossAmount       Decimal            @map("gross_amount") @db.Decimal(19, 4)
  /// Invoice currency, the rate on the invoice date and base totals (ADR-054). `cost` is base.
  currency          String             @db.Char(3)
  exchangeRate      Decimal            @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate          DateTime?          @map("rate_date") @db.Date
  netAmountBase     Decimal            @map("net_amount_base") @db.Decimal(19, 4)
  taxAmountBase     Decimal            @map("tax_amount_base") @db.Decimal(19, 4)
  grossAmountBase   Decimal            @map("gross_amount_base") @db.Decimal(19, 4)
  /// Cost of goods of the delivery, for the margin.
  cost              Decimal            @db.Decimal(19, 4)
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String?            @map("cancelled_by_user_id") @db.Uuid
  cancelReason      String?            @map("cancel_reason")

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer                    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  delivery       CustomerDelivery            @relation(fields: [organizationId, deliveryId], references: [organizationId, id], onDelete: Restrict)
  lines          SalesInvoiceLine[]
  allocations    CustomerReceiptAllocation[]
  zatcaDocuments ZatcaDocument[]

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, customerId, invoiceDate])
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "sales_invoices_number_trgm")
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  lineNo         Int      @map("line_no")
  productId      String   @map("product_id") @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(20, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(20, 6)
  taxCodeId      String?  @map("tax_code_id") @db.Uuid
  taxRate        Decimal? @map("tax_rate") @db.Decimal(9, 6)
  netAmount      Decimal  @map("net_amount") @db.Decimal(19, 4)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(19, 4)
  grossAmount    Decimal  @map("gross_amount") @db.Decimal(19, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      SalesInvoice @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  taxCode      TaxCode?     @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, invoiceId, lineNo])
  @@map("sales_invoice_lines")
}

/// Money received from a customer, applied to invoices.
model CustomerReceipt {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  number          String
  customerId      String           @map("customer_id") @db.Uuid
  /// The receiving company (ADR-086): applies only to its invoices; base amounts in its currency. Set by the database when omitted.
  companyId       String?          @map("company_id") @db.Uuid
  date            DateTime         @db.Date
  amount          Decimal          @db.Decimal(19, 4)
  /// Receipt currency, the rate on its date and base amount (ADR-054).
  currency        String           @db.Char(3)
  exchangeRate    Decimal          @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  rateDate        DateTime?        @map("rate_date") @db.Date
  amountBase      Decimal          @map("amount_base") @db.Decimal(19, 4)
  method          PaymentMethod
  reference       String?
  note            String?
  status          SettlementStatus @default(POSTED)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?          @map("voided_by_user_id") @db.Uuid
  voidReason      String?          @map("void_reason")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer                    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  company      Company?                    @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  allocations  CustomerReceiptAllocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, customerId, date])
  @@map("customer_receipts")
}

model CustomerReceiptAllocation {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  receiptId        String   @map("receipt_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  amount           Decimal  @db.Decimal(19, 4)
  /// Realised exchange difference, base: amount × (receipt rate − invoice rate); + = gain.
  fxDifferenceBase Decimal  @default(0) @map("fx_difference_base") @db.Decimal(19, 4)
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt      CustomerReceipt @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  invoice      SalesInvoice    @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, receiptId])
  @@map("customer_receipt_allocations")
}

// ─── Integrations (Milestone 10, ADR-048) ───

enum ConnectorKind {
  INBOUND_SALES_WEBHOOK
  OUTBOUND_WEBHOOK
  /// Orders from a delivery platform for one branch (POS5c, ADR-069).
  DELIVERY_ORDERS
  /// Clock-ins from a fingerprint or face device at one branch (HR2a, ADR-080).
  ATTENDANCE_DEVICE
}

enum ConnectorStatus {
  ACTIVE
  DISABLED
}

enum InboundEventStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
}

enum DeliveryAttemptStatus {
  PENDING
  DELIVERED
  FAILED
}

/// A configured integration. Its secret is stored encrypted and shown once.
model Connector {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  kind            ConnectorKind
  name            String
  status          ConnectorStatus @default(ACTIVE)
  /// Non-secret settings: inbound — warehouseId; outbound — url, events.
  config          Json
  /// Random id in the inbound URL; never the database id.
  publicId        String          @unique @map("public_id")
  secretSealed    String          @map("secret_sealed")
  secretHint      String          @map("secret_hint")
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  secretRotatedAt DateTime?       @map("secret_rotated_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events            IntegrationEvent[]
  deliveries        OutboundDelivery[]
  deliveryOrders    DeliveryOrder[]
  itemMaps          DeliveryItemMap[]
  deliveryPayouts   DeliveryPayout[]
  attendancePunches AttendancePunch[]

  @@unique([organizationId, id])
  @@map("connectors")
}

/// Every inbound request to a connector, accepted or not.
model IntegrationEvent {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  connectorId    String             @map("connector_id") @db.Uuid
  idempotencyKey String?            @map("idempotency_key")
  status         InboundEventStatus
  /// Why it was refused (signature, format, business rule), or the outcome.
  outcome        Json
  bodySha256     String             @map("body_sha256")
  bodyBytes      Int                @map("body_bytes")
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    Connector    @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, connectorId, receivedAt])
  @@map("integration_events")
}

/// Transactional outbox: written with the business change, sent by the delivery job.
model OutboundDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  connectorId    String                @map("connector_id") @db.Uuid
  eventType      String                @map("event_type")
  /// Unique per connector, e.g. "purchase_order.approved:<id>"; sent as the event id.
  eventKey       String                @map("event_key")
  payload        Json
  status         DeliveryAttemptStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    Connector    @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, connectorId, eventKey])
  @@index([status, nextAttemptAt])
  @@map("outbound_deliveries")
}

// ─── POS1a: menu (ADR-058) ───

enum SalesChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum MenuItemKind {
  /// Sold as one thing: uses a recipe (dish) or a stock product.
  ITEM
  /// A set of other items sold together at its own price.
  COMBO
}

model MenuCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  nameAr         String?   @map("name_ar")
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items         MenuItem[]
  kitchenRoutes KitchenRoute[]

  @@unique([organizationId, id])
  @@map("menu_categories")
}

/// What a cashier sells. Uses a recipe or a product (ITEM), or other items (COMBO).
model MenuItem {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String
  name            String
  nameAr          String?      @map("name_ar")
  description     String?
  categoryId      String       @map("category_id") @db.Uuid
  kind            MenuItemKind @default(ITEM)
  recipeId        String?      @map("recipe_id") @db.Uuid
  productId       String?      @map("product_id") @db.Uuid
  /// Product items: quantity used per item sold, in the product's base unit.
  productQuantity Decimal?     @map("product_quantity") @db.Decimal(20, 6)
  /// Sales tax code; null = the recipe's, else the organization's default.
  taxCodeId       String?      @map("tax_code_id") @db.Uuid
  sortOrder       Int          @default(0) @map("sort_order")
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       MenuCategory            @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  recipe         Recipe?                 @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  product        Product?                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  taxCode        TaxCode?                @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)
  prices         MenuItemPrice[]
  modifierGroups MenuItemModifierGroup[]
  components     ComboComponent[]        @relation("Combo")
  usedInCombos   ComboComponent[]        @relation("ComboComponent")
  unavailable    MenuItemUnavailable[]
  posTabLines    PosTabLine[]
  kitchenRoutes  KitchenRoute[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, categoryId])
  /// Global search (ADR-088).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "menu_items_name_trgm")
  @@map("menu_items")
}

/// Price of an item on a channel from a date; branch = null applies to all branches.
/// Append-only: a change is a new row with a later date.
model MenuItemPrice {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  itemId          String       @map("item_id") @db.Uuid
  channel         SalesChannel
  branchId        String?      @map("branch_id") @db.Uuid
  price           Decimal      @db.Decimal(19, 4)
  /// Entered including VAT (the organization's setting at the time).
  includesTax     Boolean      @map("includes_tax")
  effectiveFrom   DateTime     @map("effective_from") @db.Date
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         MenuItem     @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, itemId])
  @@map("menu_item_prices")
}

/// Choices added to an item (size, extras, without onion…).
model ModifierGroup {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  nameAr         String?   @map("name_ar")
  /// How many options must / may be chosen.
  minSelect      Int       @default(0) @map("min_select")
  maxSelect      Int       @default(1) @map("max_select")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  options      ModifierOption[]
  items        MenuItemModifierGroup[]

  @@unique([organizationId, id])
  @@map("modifier_groups")
}

/// One option: a price change and, optionally, what it uses from stock.
model ModifierOption {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  name           String
  nameAr         String?   @map("name_ar")
  /// Added to the item price (may be 0 or negative), in the price's terms (incl./excl. VAT).
  priceDelta     Decimal   @default(0) @map("price_delta") @db.Decimal(19, 4)
  /// Uses this recipe or product per option chosen (quantity in recipe portions / product base unit).
  recipeId       String?   @map("recipe_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  quantity       Decimal?  @db.Decimal(20, 6)
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict)
  recipe       Recipe?       @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict)
  product      Product?      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, groupId])
  @@map("modifier_options")
}

model MenuItemModifierGroup {
  organizationId String @map("organization_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  sortOrder      Int    @default(0) @map("sort_order")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         MenuItem      @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Restrict)
  group        ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, itemId, groupId])
  @@map("menu_item_modifier_groups")
}

/// The items a combo contains.
model ComboComponent {
  organizationId String  @map("organization_id") @db.Uuid
  comboId        String  @map("combo_id") @db.Uuid
  componentId    String  @map("component_id") @db.Uuid
  quantity       Decimal @default(1) @db.Decimal(20, 6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  combo        MenuItem     @relation("Combo", fields: [organizationId, comboId], references: [organizationId, id], onDelete: Restrict)
  component    MenuItem     @relation("ComboComponent", fields: [organizationId, componentId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, comboId, componentId])
  @@map("combo_components")
}

/// An item not offered (or sold out) at a branch.
model MenuItemUnavailable {
  organizationId String   @map("organization_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         MenuItem     @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, itemId, branchId])
  @@map("menu_item_unavailable")
}

// ─── POS1b: selling (ADR-059) ───

/// A till: sells for one branch and uses stock from one warehouse.
model PosRegister {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  code           String
  name           String
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  shifts       PosShift[]
  orders       PosOrder[]
  zatcaDevice  ZatcaDevice?

  orderingChannels OrderingChannel[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("pos_registers")
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

/// A cashier's shift on a register: opening float, cash in/out, counted cash at close.
model PosShift {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  number         String
  registerId     String         @map("register_id") @db.Uuid
  status         PosShiftStatus @default(OPEN)
  openingFloat   Decimal        @map("opening_float") @db.Decimal(19, 4)
  openedByUserId String         @map("opened_by_user_id") @db.Uuid
  openedAt       DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// At close: cash expected in the drawer, counted, and the difference (counted − expected).
  expectedCash   Decimal?       @map("expected_cash") @db.Decimal(19, 4)
  countedCash    Decimal?       @map("counted_cash") @db.Decimal(19, 4)
  cashDifference Decimal?       @map("cash_difference") @db.Decimal(19, 4)
  closeNote      String?        @map("close_note")
  closedByUserId String?        @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  register      PosRegister       @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  cashMovements PosCashMovement[]
  orders        PosOrder[]
  refunds       PosRefund[]
  giftCards     GiftCard[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, registerId])
  @@map("pos_shifts")
}

enum PosCashMovementKind {
  PAY_IN
  PAY_OUT
}

model PosCashMovement {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  shiftId         String              @map("shift_id") @db.Uuid
  kind            PosCashMovementKind
  amount          Decimal             @db.Decimal(19, 4)
  reason          String
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shift        PosShift     @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, shiftId])
  @@map("pos_cash_movements")
}

enum PosOrderStatus {
  PAID
  VOIDED
}

/// A paid order. Its id is generated by the device, so a retried submission never sells twice.
model PosOrder {
  id               String         @id @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  /// The legal entity (F1b, ADR-083): set by the database from the document's site (supplier invoices: chosen, default company otherwise); never changes.
  companyId        String?        @map("company_id") @db.Uuid
  number           String
  registerId       String         @map("register_id") @db.Uuid
  shiftId          String         @map("shift_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  warehouseId      String         @map("warehouse_id") @db.Uuid
  channel          SalesChannel
  status           PosOrderStatus @default(PAID)
  /// When the cashier took the order (device time), and its business date at the branch.
  orderedAt        DateTime       @map("ordered_at") @db.Timestamptz(3)
  businessDate     DateTime       @map("business_date") @db.Date
  netAmount        Decimal        @map("net_amount") @db.Decimal(19, 4)
  taxAmount        Decimal        @map("tax_amount") @db.Decimal(19, 4)
  grossAmount      Decimal        @map("gross_amount") @db.Decimal(19, 4)
  /// Stock value used (moving average), base currency.
  costAmount       Decimal        @default(0) @map("cost_amount") @db.Decimal(19, 4)
  consumptionDocId String?        @map("consumption_doc_id") @db.Uuid
  refundedAmount   Decimal        @default(0) @map("refunded_amount") @db.Decimal(19, 4)
  note             String?
  cashierUserId    String         @map("cashier_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedByUserId   String?        @map("voided_by_user_id") @db.Uuid
  voidReason       String?        @map("void_reason")
  voidDocId        String?        @map("void_doc_id") @db.Uuid
  /// The check (POS2a) this order paid all or part of.
  tabId            String?        @map("tab_id") @db.Uuid
  /// Discounts (POS5a, ADR-067): from promotions, and on the whole order (manual or coupon).
  promoDiscount    Decimal        @default(0) @map("promo_discount") @db.Decimal(19, 4)
  orderDiscount    Decimal        @default(0) @map("order_discount") @db.Decimal(19, 4)
  discountReason   String?        @map("discount_reason")
  couponId         String?        @map("coupon_id") @db.Uuid
  coupon           PosCoupon?     @relation(fields: [organizationId, couponId], references: [organizationId, id], onDelete: Restrict)
  /// Customers and loyalty (POS5b, ADR-068): the customer, and points spent as the order discount.
  customerId       String?        @map("customer_id") @db.Uuid
  customer         PosCustomer?   @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  loyaltyPoints    Int            @default(0) @map("loyalty_points")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  register      PosRegister               @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  shift         PosShift                  @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict)
  lines         PosOrderLine[]
  payments      PosPayment[]
  refunds       PosRefund[]
  shortfalls    PosConsumptionShortfall[]
  deliveryOrder DeliveryOrder?
  tab           PosTab?                   @relation(fields: [organizationId, tabId], references: [organizationId, id], onDelete: Restrict)

  company Company? @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, shiftId])
  @@index([organizationId, businessDate])
  @@index([organizationId, companyId, businessDate], map: "pos_orders_company_idx")
  /// Global search (ADR-088).
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "pos_orders_number_trgm")
  @@map("pos_orders")
}

/// A sold line, with the menu item, price and chosen options as they were at the sale.
model PosOrderLine {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  lineNo           Int           @map("line_no")
  menuItemId       String        @map("menu_item_id") @db.Uuid
  name             String
  quantity         Decimal       @db.Decimal(20, 6)
  /// Per item including the options' price changes, as the price was entered (incl. or excl. VAT).
  unitPrice        Decimal       @map("unit_price") @db.Decimal(19, 4)
  priceIncludesTax Boolean       @map("price_includes_tax")
  /// The check line it paid (POS2a).
  tabLineId        String?       @map("tab_line_id") @db.Uuid
  /// Taken off this line (promotion plus its share of the order discount), incl. VAT.
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(19, 4)
  promotionId      String?       @map("promotion_id") @db.Uuid
  promotion        PosPromotion? @relation(fields: [organizationId, promotionId], references: [organizationId, id], onDelete: Restrict)
  /// [{ optionId, name, priceDelta }]
  options          Json          @default("[]")
  taxCodeId        String?       @map("tax_code_id") @db.Uuid
  taxRate          Decimal?      @map("tax_rate") @db.Decimal(7, 6)
  netAmount        Decimal       @map("net_amount") @db.Decimal(19, 4)
  taxAmount        Decimal       @map("tax_amount") @db.Decimal(19, 4)
  grossAmount      Decimal       @map("gross_amount") @db.Decimal(19, 4)
  refundedQuantity Decimal       @default(0) @map("refunded_quantity") @db.Decimal(20, 6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        PosOrder     @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNo])
  @@map("pos_order_lines")
}

enum PosPaymentMethod {
  CASH
  /// Paid on a separate card terminal (no card data here; POS3 integrates terminals).
  CARD
  /// Paid from a gift card's balance (POS5b, ADR-068).
  GIFT_CARD
  /// Paid to the delivery platform, which settles with the restaurant (POS5c, ADR-069).
  DELIVERY_PLATFORM
}

model PosPayment {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  method         PosPaymentMethod
  /// Applied to the order.
  amount         Decimal          @db.Decimal(19, 4)
  /// Cash: what the customer handed over, and the change given.
  tendered       Decimal?         @db.Decimal(19, 4)
  change         Decimal?         @db.Decimal(19, 4)
  reference      String?
  /// Card details from the terminal slip (POS3a); never the full card number.
  cardScheme     CardScheme?      @map("card_scheme")
  terminalId     String?          @map("terminal_id")
  approvalCode   String?          @map("approval_code")
  cardLast4      String?          @map("card_last4")
  /// Tip added on the card, on top of the amount; not a sale, no VAT.
  tip            Decimal          @default(0) @db.Decimal(19, 4)
  giftCardId     String?          @map("gift_card_id") @db.Uuid
  giftCard       GiftCard?        @relation(fields: [organizationId, giftCardId], references: [organizationId, id], onDelete: Restrict)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order           PosOrder             @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  settlementLines CardSettlementLine[]

  @@index([organizationId, orderId])
  @@map("pos_payments")
}

/// Money given back for some or all lines of a paid order (stock is not returned).
model PosRefund {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  number          String
  orderId         String           @map("order_id") @db.Uuid
  /// The open shift the money left from.
  shiftId         String           @map("shift_id") @db.Uuid
  method          PosPaymentMethod
  amount          Decimal          @db.Decimal(19, 4)
  taxAmount       Decimal          @map("tax_amount") @db.Decimal(19, 4)
  /// [{ orderLineId, quantity, gross, tax }]
  lines           Json
  reason          String
  /// Card refunds: the terminal's reference for the refund.
  reference       String?
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        PosOrder     @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  shift        PosShift     @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, orderId])
  @@index([organizationId, shiftId])
  @@map("pos_refunds")
}

enum PosShortfallStatus {
  OPEN
  POSTED
  CANCELLED
}

/// Stock a paid order should have used but the system did not show; posted later (ADR-059).
model PosConsumptionShortfall {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  orderId        String             @map("order_id") @db.Uuid
  warehouseId    String             @map("warehouse_id") @db.Uuid
  productId      String             @map("product_id") @db.Uuid
  quantity       Decimal            @db.Decimal(20, 6)
  status         PosShortfallStatus @default(OPEN)
  documentId     String?            @map("document_id") @db.Uuid
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        PosOrder     @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("pos_consumption_shortfalls")
}

enum PosTabStatus {
  OPEN
  CLOSED
  CANCELLED
  MERGED
}

enum PosTabLineStatus {
  PENDING
  SENT
  VOIDED
}

/// A dining area of a branch with its tables; its kitchen uses stock from one warehouse (ADR-062).
model PosFloor {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  name           String
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  tables       PosTable[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, name])
  @@map("pos_floors")
}

/// A table on a floor plan; position in grid cells.
model PosTable {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  floorId        String    @map("floor_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  code           String
  seats          Int
  gridX          Int       @map("grid_x")
  gridY          Int       @map("grid_y")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  floor        PosFloor     @relation(fields: [organizationId, floorId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  tabs         PosTab[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, code])
  @@map("pos_tables")
}

/// An open check: items added during the meal, sent to the kitchen, paid whole or in parts (ADR-062).
enum PosTabSource {
  STAFF
  WEB
  KIOSK
}

enum OrderingChannelKind {
  WEB
  KIOSK
}

/// A public ordering page for one branch: the online ordering site or a self-order kiosk (ADR-070).
enum GuestPaymentMode {
  COUNTER
  ONLINE
  CHOICE
}

model OrderingChannel {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  kind            OrderingChannelKind
  name            String
  branchId        String              @map("branch_id") @db.Uuid
  /// Eat in and/or take away (kiosk), take away for pick-up (web).
  channels        SalesChannel[]
  /// Send to the kitchen as soon as the guest orders, without a person accepting.
  autoSend        Boolean             @default(false) @map("auto_send")
  maxOrderTotal   Decimal?            @map("max_order_total") @db.Decimal(19, 4)
  /// How guests pay (ADR-071): at the counter, online before the kitchen starts, or their choice.
  paymentMode     GuestPaymentMode    @default(COUNTER) @map("payment_mode")
  /// The register whose open shift records online payments (needed unless COUNTER).
  registerId      String?             @map("register_id") @db.Uuid
  register        PosRegister?        @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  /// Pick-up times: offered between these local times, in slots, at least this long from now.
  scheduling      Boolean             @default(false)
  openFrom        String?             @map("open_from")
  openTo          String?             @map("open_to")
  slotMinutes     Int                 @default(15) @map("slot_minutes")
  leadMinutes     Int                 @default(20) @map("lead_minutes")
  daysAhead       Int                 @default(0) @map("days_ahead")
  /// Most orders per pick-up slot (kitchen capacity); null = no limit.
  slotCapacity    Int?                @map("slot_capacity")
  /// Random id in the public address; never the database id.
  publicToken     String              @unique @map("public_token")
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt      DateTime?           @map("archived_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  tabs         PosTab[]

  @@unique([organizationId, id])
  @@map("ordering_channels")
}

model PosTab {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  number          String
  branchId        String           @map("branch_id") @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.Uuid
  tableId         String?          @map("table_id") @db.Uuid
  /// Name for a check without a table (bar, pick-up).
  label           String?
  guests          Int
  channel         SalesChannel     @default(DINE_IN)
  status          PosTabStatus     @default(OPEN)
  waiterUserId    String           @map("waiter_user_id") @db.Uuid
  openedAt        DateTime         @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt        DateTime?        @map("closed_at") @db.Timestamptz(3)
  mergedIntoTabId String?          @map("merged_into_tab_id") @db.Uuid
  cancelReason    String?          @map("cancel_reason")
  /// Orders placed by guests (POS5d, ADR-070): the web or kiosk channel, the guest, and the
  /// guest's status link. The phone is cleared when the check closes.
  source          PosTabSource     @default(STAFF)
  sourceChannelId String?          @map("source_channel_id") @db.Uuid
  sourceKey       String?          @map("source_key")
  guestName       String?          @map("guest_name")
  guestPhone      String?          @map("guest_phone")
  guestToken      String?          @unique @map("guest_token")
  /// Guest order fulfilment (ADR-071): paid online, pick-up time, accepted, ready, handed over.
  payOnline       Boolean          @default(false) @map("pay_online")
  pickupAt        DateTime?        @map("pickup_at") @db.Timestamptz(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  readyAt         DateTime?        @map("ready_at") @db.Timestamptz(3)
  pickedUpAt      DateTime?        @map("picked_up_at") @db.Timestamptz(3)
  sourceChannel   OrderingChannel? @relation(fields: [organizationId, sourceChannelId], references: [organizationId, id], onDelete: Restrict)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  table        PosTable?    @relation(fields: [organizationId, tableId], references: [organizationId, id], onDelete: Restrict)
  lines        PosTabLine[]
  orders       PosOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, sourceChannelId, sourceKey])
  @@index([organizationId, branchId, status])
  @@map("pos_tabs")
}

/// An item on a check. PENDING until sent to the kitchen; a sent item is removed only by voiding it.
model PosTabLine {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  tabId           String           @map("tab_id") @db.Uuid
  lineNo          Int              @map("line_no")
  menuItemId      String           @map("menu_item_id") @db.Uuid
  name            String
  quantity        Decimal          @db.Decimal(20, 6)
  optionIds       String[]         @map("option_ids") @db.Uuid
  /// Option names as chosen, for the kitchen and the screen.
  optionNames     Json             @map("option_names")
  seat            Int?
  course          Int              @default(1)
  note            String?
  /// Held lines wait for their course to be fired.
  hold            Boolean          @default(false)
  status          PosTabLineStatus @default(PENDING)
  sentAt          DateTime?        @map("sent_at") @db.Timestamptz(3)
  sentByUserId    String?          @map("sent_by_user_id") @db.Uuid
  voidedAt        DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?          @map("voided_by_user_id") @db.Uuid
  voidReason      String?          @map("void_reason")
  /// Write-off of what the kitchen had made, when a sent item is voided.
  wasteDocId      String?          @map("waste_doc_id") @db.Uuid
  paidQuantity    Decimal          @default(0) @map("paid_quantity") @db.Decimal(20, 6)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tab          PosTab       @relation(fields: [organizationId, tabId], references: [organizationId, id], onDelete: Restrict)
  menuItem     MenuItem     @relation(fields: [organizationId, menuItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([tabId, lineNo])
  @@index([organizationId, tabId])
  @@map("pos_tab_lines")
}

enum KitchenTicketStatus {
  OPEN
  DONE
}

/// A kitchen station of a branch with its screen (POS2b, ADR-063).
model KitchenStation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  code           String
  name           String
  /// Minutes a ticket should take; the screen warns before and marks it late after.
  targetMinutes  Int       @default(12) @map("target_minutes")
  /// Receives items no route sends elsewhere.
  isDefault      Boolean   @default(false) @map("is_default")
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  routes       KitchenRoute[]
  tickets      KitchenTicket[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, code])
  @@map("kitchen_stations")
}

/// Sends a menu category, or one item, to a station at a branch.
model KitchenRoute {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  stationId      String   @map("station_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  menuItemId     String?  @map("menu_item_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station      KitchenStation @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Cascade)
  category     MenuCategory?  @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  menuItem     MenuItem?      @relation(fields: [organizationId, menuItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, categoryId])
  @@unique([organizationId, branchId, menuItemId])
  @@map("kitchen_routes")
}

/// What one station must prepare from one send (a check) or one counter order.
model KitchenTicket {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  stationId      String              @map("station_id") @db.Uuid
  tabId          String?             @map("tab_id") @db.Uuid
  orderId        String?             @map("order_id") @db.Uuid
  /// Table, check name or order number, as shown to the kitchen.
  label          String
  guests         Int?
  status         KitchenTicketStatus @default(OPEN)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  bumpedAt       DateTime?           @map("bumped_at") @db.Timestamptz(3)
  bumpedByUserId String?             @map("bumped_by_user_id") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  station      KitchenStation      @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)
  items        KitchenTicketItem[]

  @@unique([organizationId, id])
  @@index([organizationId, stationId, status])
  @@index([organizationId, tabId])
  @@index([organizationId, orderId])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  tabLineId      String?   @map("tab_line_id") @db.Uuid
  orderLineId    String?   @map("order_line_id") @db.Uuid
  name           String
  quantity       Decimal   @db.Decimal(20, 6)
  options        Json
  note           String?
  seat           Int?
  course         Int?
  /// Set when the item was voided after it reached the kitchen.
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       KitchenTicket @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, tabLineId])
  @@index([organizationId, orderLineId])
  @@map("kitchen_ticket_items")
}

enum ZatcaEnvironment {
  DEVELOPER_PORTAL
  SIMULATION
  CORE
}

enum ZatcaDeviceStatus {
  /// Key and CSR made; waiting for the OTP from the Fatoora portal.
  NEW
  /// Compliance certificate received; compliance checks to pass.
  COMPLIANCE
  /// Production certificate: documents are signed and reported.
  ACTIVE
  RETIRED
}

enum ZatcaDocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ZatcaDocumentStatus {
  PENDING
  REPORTED
  REPORTED_WITH_WARNINGS
  REJECTED
  /// Standard (B2B) documents: cleared by ZATCA before they are given to the buyer (ADR-072).
  CLEARED
  CLEARED_WITH_WARNINGS
}

/// Simplified (B2C, reported) or standard (B2B, cleared) — ADR-072.
enum ZatcaDocumentKind {
  SIMPLIFIED
  STANDARD
}

/// A unit for a register's simplified invoices, or the back office's standard invoices.
enum ZatcaUnitPurpose {
  POS
  OFFICE
}

/// Seller details printed on e-invoices and the ZATCA environment (POS4, ADR-064).
/// The ZATCA seller of one company (ADR-085): its national address and environment.
model ZatcaSettings {
  organizationId   String           @map("organization_id") @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  legalName        String           @map("legal_name")
  crNumber         String?          @map("cr_number")
  street           String
  building         String
  district         String
  city             String
  postalCode       String           @map("postal_code")
  businessCategory String           @map("business_category")
  environment      ZatcaEnvironment @default(DEVELOPER_PORTAL)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, companyId])
  @@map("zatca_settings")
}

/// An e-invoicing unit (EGS) — one per register — with its keys, certificates and invoice chain.
model ZatcaDevice {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  /// The register (POS); none for the back-office unit (OFFICE, ADR-072).
  registerId          String?           @map("register_id") @db.Uuid
  purpose             ZatcaUnitPurpose  @default(POS)
  /// The seller (ADR-085): the register's branch's company, or the office unit's company. Set by the database.
  companyId           String?           @map("company_id") @db.Uuid
  environment         ZatcaEnvironment
  commonName          String            @map("common_name")
  serialNumber        String            @map("serial_number")
  status              ZatcaDeviceStatus @default(NEW)
  /// AES-256-GCM sealed (integrations key); never leaves the server.
  privateKeySealed    String            @map("private_key_sealed")
  csr                 String
  complianceRequestId String?           @map("compliance_request_id")
  complianceToken     String?           @map("compliance_token")
  complianceSecret    String?           @map("compliance_secret_sealed")
  productionToken     String?           @map("production_token")
  productionSecret    String?           @map("production_secret_sealed")
  /// Invoice counter value of the last document (KSA-16).
  icv                 Int               @default(0)
  /// Hash of the last document (the next one's PIH).
  lastHash            String            @map("last_hash")
  onboardedAt         DateTime?         @map("onboarded_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  register     PosRegister?    @relation(fields: [organizationId, registerId], references: [organizationId, id], onDelete: Restrict)
  company      Company?        @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  documents    ZatcaDocument[]

  @@unique([organizationId, id])
  @@unique([organizationId, registerId])
  @@map("zatca_devices")
}

/// A signed e-invoice document (invoice, credit or debit note) and its reporting to ZATCA.
model ZatcaDocument {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  deviceId       String              @map("device_id") @db.Uuid
  type           ZatcaDocumentType
  orderId        String?             @map("order_id") @db.Uuid
  refundId       String?             @map("refund_id") @db.Uuid
  /// Standard documents (ADR-072): the B2B sales invoice, and ZATCA's cleared document (the legal one).
  kind           ZatcaDocumentKind   @default(SIMPLIFIED)
  salesInvoiceId String?             @map("sales_invoice_id") @db.Uuid
  clearedXml     String?             @map("cleared_xml")
  salesInvoice   SalesInvoice?       @relation(fields: [organizationId, salesInvoiceId], references: [organizationId, id], onDelete: Restrict)
  number         String
  uuid           String              @db.Uuid
  icv            Int
  pih            String
  invoiceHash    String              @map("invoice_hash")
  xml            String
  qr             String
  status         ZatcaDocumentStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  response       Json?
  reportedAt     DateTime?           @map("reported_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device       ZatcaDevice  @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([deviceId, icv])
  @@index([organizationId, orderId])
  @@index([organizationId, salesInvoiceId])
  @@index([status, nextAttemptAt])
  @@map("zatca_documents")
}

enum CardScheme {
  MADA
  VISA
  MASTERCARD
  AMEX
  OTHER
}

enum SettlementMatch {
  MATCHED
  AMOUNT_MISMATCH
  UNMATCHED
}

/// An acquirer settlement file imported for reconciliation (POS3a, ADR-065).
model CardSettlementBatch {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  fileName         String   @map("file_name")
  sha256           String
  lineCount        Int      @map("line_count")
  importedByUserId String   @map("imported_by_user_id") @db.Uuid
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        CardSettlementLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sha256])
  @@map("card_settlement_batches")
}

/// One settled card transaction, matched to the POS card payment it pays out.
model CardSettlementLine {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  batchId         String          @map("batch_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date") @db.Date
  terminalId      String?         @map("terminal_id")
  approvalCode    String          @map("approval_code")
  /// Charged to the card (sale share plus tip).
  amount          Decimal         @db.Decimal(19, 4)
  fee             Decimal         @default(0) @db.Decimal(19, 4)
  paymentId       String?         @map("payment_id") @db.Uuid
  match           SettlementMatch

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch        CardSettlementBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  payment      PosPayment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId, transactionDate])
  @@map("card_settlement_lines")
}

enum PaymentProviderMode {
  TEST
  LIVE
}

enum PaymentLinkStatus {
  /// Link made; waiting for the customer.
  CREATED
  /// Paid at the provider; the order is being recorded.
  PAID
  /// Paid and recorded as an order.
  RECORDED
  FAILED
  CANCELLED
}

/// The organization's online payment provider account (POS3b, ADR-066). Moyasar in Saudi Arabia.
model PaymentProviderSettings {
  organizationId  String              @id @map("organization_id") @db.Uuid
  provider        String              @default("MOYASAR")
  mode            PaymentProviderMode @default(TEST)
  /// Secret API key, AES-256-GCM sealed; never shown again.
  secretKeySealed String              @map("secret_key_sealed")
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("payment_provider_settings")
}

/// A pay-by-QR link for (part of) a check; recorded as an order once the provider confirms payment.
model PaymentLink {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  provider          String
  providerInvoiceId String            @map("provider_invoice_id")
  url               String
  tabId             String            @map("tab_id") @db.Uuid
  registerId        String            @map("register_id") @db.Uuid
  /// The order id used when the payment is recorded (a retry records it once).
  orderId           String            @map("order_id") @db.Uuid
  /// [{ tabLineId, quantity }] — empty = everything left.
  lines             Json
  amount            Decimal           @db.Decimal(19, 4)
  currency          String
  status            PaymentLinkStatus @default(CREATED)
  providerPaymentId String?           @map("provider_payment_id")
  /// The paying card as reported by the provider (last 4 digits only).
  cardScheme        CardScheme?       @map("card_scheme")
  cardLast4         String?           @map("card_last4")
  /// Why a paid link could not be recorded (needs a manager).
  problem           String?
  createdByUserId   String            @map("created_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt            DateTime?         @map("paid_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, providerInvoiceId])
  @@index([organizationId, tabId])
  @@map("payment_links")
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

/// An automatic percentage off items or categories at set times (POS5a, ADR-067). Fixed once created.
model PosPromotion {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  percent        Decimal        @db.Decimal(5, 2)
  categoryIds    String[]       @map("category_ids") @db.Uuid
  itemIds        String[]       @map("item_ids") @db.Uuid
  channels       SalesChannel[]
  weekdays       Int[]
  startTime      String?        @map("start_time")
  endTime        String?        @map("end_time")
  validFrom      DateTime       @map("valid_from") @db.Date
  validTo        DateTime?      @map("valid_to") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderLines   PosOrderLine[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("pos_promotions")
}

/// A coupon code for a discount on the whole order.
model PosCoupon {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  kind           DiscountKind
  value          Decimal      @db.Decimal(19, 4)
  validFrom      DateTime     @map("valid_from") @db.Date
  validTo        DateTime?    @map("valid_to") @db.Date
  maxUses        Int?         @map("max_uses")
  uses           Int          @default(0)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders       PosOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("pos_coupons")
}

// ─── Customers, loyalty and gift cards (POS5b, ADR-068) ───

/// A guest who gave their phone number. Erasing anonymizes the row and keeps the ledger.
model PosCustomer {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  /// E.164 (+9665…); null once erased.
  phone            String?
  email            String?
  /// Agreed to receive offers (PDPL): when and from whom it was recorded.
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz(3)
  pointsBalance    Int       @default(0) @map("points_balance")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt         DateTime? @map("erased_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders         PosOrder[]
  loyaltyEntries LoyaltyEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, phone])
  /// Global search (ADR-088).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "pos_customers_name_trgm")
  @@map("pos_customers")
}

/// How points are earned and spent; one per organization.
model LoyaltySettings {
  organizationId  String   @id @map("organization_id") @db.Uuid
  enabled         Boolean  @default(false)
  /// Points per one unit of the base currency paid (after discounts).
  earnRate        Decimal  @map("earn_rate") @db.Decimal(9, 4)
  /// Base currency per point when spent.
  pointValue      Decimal  @map("point_value") @db.Decimal(9, 4)
  minRedeemPoints Int      @default(0) @map("min_redeem_points")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("loyalty_settings")
}

enum LoyaltyEntryKind {
  EARN
  REDEEM
  REVERSAL
  ADJUSTMENT
}

/// Insert-only points ledger; the customer's balance is the sum.
model LoyaltyEntry {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  kind            LoyaltyEntryKind
  points          Int
  orderId         String?          @map("order_id") @db.Uuid
  reason          String?
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     PosCustomer  @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, customerId])
  @@map("loyalty_entries")
}

/// Stored value sold to a guest: a liability until spent. The code is kept only as a keyed hash.
model GiftCard {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  codeHash       String           @map("code_hash")
  last4          String
  initialValue   Decimal          @map("initial_value") @db.Decimal(19, 4)
  balance        Decimal          @db.Decimal(19, 4)
  currency       String           @db.Char(3)
  /// The shift it was sold in and how it was paid (counted in that shift's cash).
  shiftId        String           @map("shift_id") @db.Uuid
  soldMethod     PosPaymentMethod @map("sold_method")
  soldByUserId   String           @map("sold_by_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  blockedAt      DateTime?        @map("blocked_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shift        PosShift        @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict)
  entries      GiftCardEntry[]
  payments     PosPayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, codeHash])
  @@index([organizationId, shiftId])
  @@map("gift_cards")
}

enum GiftCardEntryKind {
  ISSUE
  REDEEM
  REVERSAL
}

/// Insert-only gift card ledger; the balance is the sum.
model GiftCardEntry {
  id              String            @id @default(uuid(7)) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  giftCardId      String            @map("gift_card_id") @db.Uuid
  kind            GiftCardEntryKind
  amount          Decimal           @db.Decimal(19, 4)
  orderId         String?           @map("order_id") @db.Uuid
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  giftCard     GiftCard     @relation(fields: [organizationId, giftCardId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, giftCardId])
  @@map("gift_card_entries")
}

// ─── Delivery platforms (POS5c, ADR-069) ───

enum DeliveryPlatform {
  HUNGERSTATION
  JAHEZ
  KEETA
  OTHER
}

enum DeliveryOrderStatus {
  /// Waiting for the branch to accept or reject.
  PENDING
  /// Items without a menu item: someone maps them, then it can be accepted.
  NEEDS_MAPPING
  ACCEPTED
  REJECTED
  /// Cancelled by the platform.
  CANCELLED
}

/// An order received from a delivery platform; becomes a POS order when accepted.
model DeliveryOrder {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  connectorId     String               @map("connector_id") @db.Uuid
  platform        DeliveryPlatform
  /// The platform's order id (unique per connector).
  externalId      String               @map("external_id")
  /// The platform's short code the rider shows, if any.
  displayCode     String?              @map("display_code")
  status          DeliveryOrderStatus
  /// The order in the canonical format, without customer contact details.
  payload         Json
  total           Decimal              @db.Decimal(19, 4)
  /// First name or label for the kitchen; no phone or address is kept.
  customerName    String?              @map("customer_name")
  placedAt        DateTime             @map("placed_at") @db.Timestamptz(3)
  receivedAt      DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  decidedAt       DateTime?            @map("decided_at") @db.Timestamptz(3)
  decidedByUserId String?              @map("decided_by_user_id") @db.Uuid
  /// Why it could not be accepted, or what needs a person after a cancellation.
  problem         String?
  posOrderId      String?              @map("pos_order_id") @db.Uuid
  posOrder        PosOrder?            @relation(fields: [organizationId, posOrderId], references: [organizationId, id], onDelete: Restrict)
  payoutLines     DeliveryPayoutLine[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    Connector    @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([connectorId, externalId])
  @@unique([organizationId, posOrderId])
  @@index([organizationId, status, receivedAt])
  @@map("delivery_orders")
}

enum DeliveryMapKind {
  ITEM
  OPTION
}

/// A platform's item or modifier id → our menu item or option.
model DeliveryItemMap {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  connectorId    String          @map("connector_id") @db.Uuid
  kind           DeliveryMapKind
  externalId     String          @map("external_id")
  /// Menu item (ITEM) or modifier option (OPTION).
  targetId       String          @map("target_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    Connector    @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([connectorId, kind, externalId])
  @@map("delivery_item_maps")
}

enum DeliveryPayoutStatus {
  DRAFT
  /// Checked and accepted; fixed from here on.
  CONFIRMED
}

enum DeliveryPayoutMatch {
  /// The platform paid for an accepted order at the amount we recorded.
  MATCHED
  /// Accepted order, but the platform's order amount differs from ours.
  AMOUNT_DIFFERS
  /// No delivery order with this id on the connector.
  NOT_FOUND
  /// The order was cancelled by the platform.
  CANCELLED_ORDER
  /// The order was never accepted (rejected or still waiting).
  NOT_ACCEPTED
  /// Already settled by another confirmed payout.
  ALREADY_PAID
  /// A line without an order: an adjustment, a fee or a correction.
  ADJUSTMENT
}

/// A delivery platform's settlement statement (ADR-075): what it paid for
/// which orders, after commission and fees.
model DeliveryPayout {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  connectorId       String               @map("connector_id") @db.Uuid
  /// The platform's statement or transfer reference.
  reference         String
  periodFrom        DateTime             @map("period_from") @db.Date
  periodTo          DateTime             @map("period_to") @db.Date
  paidOn            DateTime?            @map("paid_on") @db.Date
  status            DeliveryPayoutStatus @default(DRAFT)
  gross             Decimal              @db.Decimal(19, 4)
  commission        Decimal              @db.Decimal(19, 4)
  fees              Decimal              @db.Decimal(19, 4)
  vatOnFees         Decimal              @map("vat_on_fees") @db.Decimal(19, 4)
  net               Decimal              @db.Decimal(19, 4)
  /// What actually arrived in the bank, if entered.
  receivedAmount    Decimal?             @map("received_amount") @db.Decimal(19, 4)
  fileName          String?              @map("file_name")
  note              String?
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedByUserId String?              @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?            @map("confirmed_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connector    Connector            @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)
  lines        DeliveryPayoutLine[]

  @@unique([organizationId, id])
  @@unique([connectorId, reference])
  @@index([organizationId, createdAt])
  @@map("delivery_payouts")
}

model DeliveryPayoutLine {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  payoutId        String              @map("payout_id") @db.Uuid
  lineNo          Int                 @map("line_no")
  /// The platform's order id; null for adjustments.
  externalId      String?             @map("external_id")
  description     String?
  gross           Decimal             @db.Decimal(19, 4)
  commission      Decimal             @db.Decimal(19, 4)
  fees            Decimal             @db.Decimal(19, 4)
  vatOnFees       Decimal             @map("vat_on_fees") @db.Decimal(19, 4)
  net             Decimal             @db.Decimal(19, 4)
  match           DeliveryPayoutMatch
  deliveryOrderId String?             @map("delivery_order_id") @db.Uuid
  /// Our recorded order total when matched.
  recordedTotal   Decimal?            @map("recorded_total") @db.Decimal(19, 4)
  /// Set when the payout is confirmed: this line settles its order (at most one line per order).
  settled         Boolean             @default(false)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payout        DeliveryPayout @relation(fields: [organizationId, payoutId], references: [organizationId, id], onDelete: Cascade)
  deliveryOrder DeliveryOrder? @relation(fields: [organizationId, deliveryOrderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([payoutId, lineNo])
  @@index([organizationId, deliveryOrderId])
  @@map("delivery_payout_lines")
}

// ─── HR (HR1, ADR-079) ───

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum EmployeeDocumentType {
  NATIONAL_ID
  IQAMA
  PASSPORT
  WORK_PERMIT
  HEALTH_CERTIFICATE
  DRIVING_LICENSE
  CONTRACT
  OTHER
}

model Department {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  nameAr         String?   @map("name_ar")
  parentId       String?   @map("parent_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Department?  @relation("DepartmentTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     Department[] @relation("DepartmentTree")
  employees    Employee[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("departments")
}

/// An employee record (HRIS). Not every employee signs in: userId links the
/// optional app account.
model Employee {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  number            String
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  nameAr            String?        @map("name_ar")
  email             String?
  phone             String?
  /// ISO 3166-1 alpha-2.
  nationality       String?
  /// National ID or iqama number; shown only to hr.manage.
  nationalId        String?        @map("national_id")
  jobTitle          String         @map("job_title")
  branchId          String         @map("branch_id") @db.Uuid
  departmentId      String?        @map("department_id") @db.Uuid
  managerId         String?        @map("manager_id") @db.Uuid
  employmentType    EmploymentType @map("employment_type")
  hireDate          DateTime       @map("hire_date") @db.Date
  status            EmployeeStatus @default(ACTIVE)
  terminatedOn      DateTime?      @map("terminated_on") @db.Date
  terminationReason String?        @map("termination_reason")
  userId            String?        @map("user_id") @db.Uuid
  /// Clock-in PIN for the branch tablet (scrypt; never shown).
  pinHash           String?        @map("pin_hash")
  pinFailures       Int            @default(0) @map("pin_failures")
  pinLockedUntil    DateTime?      @map("pin_locked_until") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  department       Department?        @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  manager          Employee?          @relation("ReportingLine", fields: [organizationId, managerId], references: [organizationId, id], onDelete: Restrict)
  reports          Employee[]         @relation("ReportingLine")
  user             User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents        EmployeeDocument[]
  punches          AttendancePunch[]
  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, userId])
  @@index([organizationId, branchId, status])
  /// Global search (ADR-088).
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employees_first_name_trgm")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "employees_last_name_trgm")
  @@map("employees")
}

model EmployeeDocument {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  employeeId     String               @map("employee_id") @db.Uuid
  type           EmployeeDocumentType
  /// Shown only to hr.manage.
  number         String?
  issuedOn       DateTime?            @map("issued_on") @db.Date
  expiresOn      DateTime?            @map("expires_on") @db.Date
  note           String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, expiresOn])
  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// ─── Attendance (HR2a, ADR-080) ───

enum AttendanceSource {
  /// The branch clock-in tablet (employee number and PIN).
  TERMINAL
  /// The employee's own phone, signed in.
  PHONE
  /// A fingerprint or face device, through a connector.
  DEVICE
  /// Entered by HR, with a reason.
  MANUAL
}

enum PunchKind {
  IN
  OUT
}

/// A branch clock-in tablet, opened through its secret link.
model AttendanceTerminal {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String
  publicToken    String   @unique @map("public_token")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  punches      AttendancePunch[]

  @@unique([organizationId, id])
  @@map("attendance_terminals")
}

/// Where staff may clock in from their phones (optional per branch).
model BranchGeofence {
  branchId       String   @id @map("branch_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  radiusMeters   Int      @map("radius_meters")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, branchId])
  @@map("branch_geofences")
}

model AttendancePunch {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  kind             PunchKind
  at               DateTime         @db.Timestamptz(3)
  source           AttendanceSource
  terminalId       String?          @map("terminal_id") @db.Uuid
  connectorId      String?          @map("connector_id") @db.Uuid
  /// The device's own id for the punch (repeats are ignored).
  externalId       String?          @map("external_id")
  /// Phone clock-in: distance from the branch, when the branch has a location. No coordinates are kept.
  distanceMeters   Int?             @map("distance_meters")
  recordedByUserId String?          @map("recorded_by_user_id") @db.Uuid
  reason           String?
  voidedAt         DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedByUserId   String?          @map("voided_by_user_id") @db.Uuid
  voidReason       String?          @map("void_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  terminal     AttendanceTerminal? @relation(fields: [organizationId, terminalId], references: [organizationId, id], onDelete: Restrict)
  connector    Connector?          @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)

  @@unique([connectorId, externalId])
  @@index([organizationId, employeeId, at])
  @@index([organizationId, branchId, at])
  @@map("attendance_punches")
}

// ─── Leave (HR2b, ADR-081) ───

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  nameAr         String?   @map("name_ar")
  /// ISO 3166-1 alpha-2; null = every country.
  country        String?
  paid           Boolean
  /// Whether days come out of a yearly entitlement (unpaid leave usually does not).
  usesBalance    Boolean   @map("uses_balance")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocations  LeaveAllocation[]
  requests     LeaveRequest[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("leave_types")
}

/// The days an employee is entitled to for a leave type in a year (set by HR).
model LeaveAllocation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  leaveTypeId    String   @map("leave_type_id") @db.Uuid
  year           Int
  days           Decimal  @db.Decimal(6, 2)
  note           String?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, employeeId, leaveTypeId, year])
  @@map("leave_allocations")
}

model LeaveRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  /// Calendar days, both ends included.
  days              Decimal            @db.Decimal(6, 2)
  reason            String?
  status            LeaveRequestStatus @default(PENDING)
  requestedByUserId String             @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?            @map("decision_note")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@map("leave_requests")
}

// ─── Enterprise layer (F1, ADR-082) ───

/// A legal entity of the group (organization): its own registrations; branches belong to one.
model Company {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  /// Trading name.
  name           String
  legalName      String    @map("legal_name")
  /// ISO 3166-1 alpha-2.
  country        String?   @db.Char(2)
  /// ISO 4217; the group's base currency until per-company books (F1b).
  currency       String    @db.Char(3)
  vatNumber      String?   @map("vat_number")
  /// VAT registered in its country (ADR-084): its sales charge VAT at its country's rates.
  vatRegistered  Boolean   @default(false) @map("vat_registered")
  crNumber       String?   @map("cr_number")
  /// The company new branches join when none is chosen (one per organization).
  isDefault      Boolean   @default(false) @map("is_default")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches         Branch[]
  posOrders        PosOrder[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  supplierInvoices SupplierInvoice[]
  zatcaSettings    ZatcaSettings[]
  zatcaDevices     ZatcaDevice[]
  settlements      SupplierSettlement[]
  fxRevaluations   FxRevaluation[]
  customerReceipts CustomerReceipt[]
  apiClients       ApiClient[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("companies")
}

model Brand {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  nameAr         String?   @map("name_ar")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@map("brands")
}

// ─── Platform services (F2a, ADR-087) ───

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A unit of background work (PostgreSQL-backed queue). System jobs have no organization.
model Job {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  kind           String
  payload        Json      @default("{}")
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?   @map("locked_by")
  /// The error of the last failed attempt (message only; never secrets).
  lastError      String?   @map("last_error")
  /// What the job reported (counts only).
  result         Json?
  /// One job per key (e.g. a daily digest per organization and day).
  dedupeKey      String?   @unique @map("dedupe_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("jobs")
}

/// An in-app notification for one user of one organization.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String
  /// Values for the message (numbers, document numbers) — never secrets.
  params         Json      @default("{}")
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  /// Path below /o/<slug> to open.
  link           String?
  dedupeKey      String?   @map("dedupe_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// A user's choice to receive a kind of notification (default: on).
model NotificationPreference {
  organizationId String  @map("organization_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  kind           String
  inApp          Boolean @default(true) @map("in_app")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId, kind])
  @@map("notification_preferences")
}

/// A key for the REST API v1 (ADR-090). The secret is shown once; only its SHA-256 is kept.
model ApiClient {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  /// Public part of the key (fa_<prefix>_<secret>), used to find the client.
  keyPrefix       String    @unique @map("key_prefix")
  keyHash         String    @map("key_hash")
  /// Read scopes, e.g. "products:read".
  scopes          String[]
  /// Only this company's documents and sites, when set (ADR-082).
  companyId       String?   @map("company_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@map("api_clients")
}
