# Copy to `.env` for local development. Placeholder values only — never commit real secrets.

# PostgreSQL connection used by the app and the Prisma CLI.
DATABASE_URL="postgresql://food:food_dev_password@localhost:5432/food_ambassador?schema=public"

# Separate database for integration and E2E tests. Tests add uniquely named data and never reset it; never point it at real data.
TEST_DATABASE_URL="postgresql://food:food_dev_password@localhost:5432/food_ambassador_test?schema=public"

# Log verbosity: fatal | error | warn | info | debug
LOG_LEVEL="info"

# Public base URL of the application (used for absolute links and auth callbacks from Milestone 1).
APP_URL="http://localhost:3000"

# Secret for signing sessions (32+ characters). Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Reverse proxies in front of the app that append to X-Forwarded-For (0 if exposed directly).
TRUSTED_PROXY_HOPS="1"

# Encrypts integration connector secrets: 32 random bytes, base64 (openssl rand -base64 32).
# Optional — derived from AUTH_SECRET when unset, but then rotating AUTH_SECRET makes
# stored connector secrets unreadable (re-create them).
INTEGRATION_ENCRYPTION_KEY=""

# 1 = outbound webhooks may use http:// and private addresses. Never in production.
INTEGRATIONS_ALLOW_PRIVATE_URLS="0"
